---
import BaseLayout from '@/layouts/BaseLayout.astro';
import canonData from '@/data/canon.json';

interface CanonEntry {
  id: string;
  title: string;
  medium: string;
  status: string;
  alias?: string;
  year?: number;
  venue?: string;
  url?: string;
  tags?: string[];
  notes?: string;
  added: string;
}

const canon = canonData as CanonEntry[];

// Medium display order + labels
const mediumOrder: Record<string, string> = {
  wargame: 'Wargames',
  album: 'Albums',
  ep: 'EPs',
  single: 'Singles',
  rpg: 'RPG',
  game: 'Games',
  essay: 'Essays',
  book: 'Books',
  software: 'Software',
  other: 'Other',
};

// Status display
const statusLabel: Record<string, string> = {
  released: 'released',
  'in-progress': 'in progress',
  unpublished: 'unpublished',
  abandoned: 'abandoned',
  lost: 'lost',
};

// Group entries by medium, preserving order
const grouped = Object.keys(mediumOrder).reduce<Record<string, CanonEntry[]>>((acc, med) => {
  const entries = canon.filter((e) => e.medium === med);
  if (entries.length > 0) acc[med] = entries;
  return acc;
}, {});

// Count totals for header
const totalReleased = canon.filter((e) => e.status === 'released').length;
const totalEntries = canon.length;
---

<BaseLayout
  title="Works | Ray Weiss"
  description="Ray Weiss's complete body of work. Wargames published under Conflict Simulations LLC, music released as Le Rug and other projects, games, essays, and a book in progress."
>
  <div class="doc__frame">
    <header class="page-heading">
      <h1>Works</h1>
      <p class="dek">
        Every wargame, album, game, RPG, essay, and book in one place. Sourced from <a
          href="https://github.com/lerugray/mission-canon">mission-canon</a
        >
        — a personal ledger Ray maintains as a living record of his creative output. Unverified entries
        (year or attribution uncertain) are marked with a
        <span class="unverified-mark">?</span>.
      </p>
    </header>

    <div class="works-stats">
      <span><span class="stat-num">{totalReleased}</span> released</span>
      <span><span class="stat-num">{totalEntries}</span> total entries</span>
    </div>

    {
      Object.entries(grouped).map(([medium, entries]) => (
        <section class="works-section">
          <div class="section-head">
            <h2 class="section-label">{mediumOrder[medium]}</h2>
            <span class="section-count">
              {entries.length} {entries.length === 1 ? 'entry' : 'entries'}
            </span>
          </div>

          <ol class="works-list">
            {entries.map((entry) => {
              const isUnverified = entry.tags?.includes('unverified');
              const statusText = statusLabel[entry.status] ?? entry.status;
              const statusIsNeutral = entry.status === 'released';
              return (
                <li class="works-entry">
                  <div class="works-year">
                    {entry.year ? (
                      <span class={isUnverified ? 'unverified' : ''}>
                        {entry.year}
                        {isUnverified && <span class="unverified-mark">?</span>}
                      </span>
                    ) : (
                      <span class="unverified-mark">?</span>
                    )}
                  </div>
                  <div class="works-body">
                    {entry.url ? (
                      <a href={entry.url} class="works-title">
                        {entry.title}
                      </a>
                    ) : (
                      <span class="works-title">{entry.title}</span>
                    )}
                    <div class="works-meta">
                      {entry.alias && <span class="works-alias">{entry.alias}</span>}
                      {entry.venue && entry.venue !== entry.alias && (
                        <span class="works-venue">{entry.venue}</span>
                      )}
                      {!statusIsNeutral && (
                        <span class={`works-status works-status--${entry.status}`}>
                          {statusText}
                        </span>
                      )}
                    </div>
                    {entry.notes && <p class="works-notes">{entry.notes}</p>}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  /* Works: the catalog as one ruled index, year, title and venue, then the note. */
  .unverified-mark {
    margin-left: var(--space-3xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
    vertical-align: super;
  }
  .works-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) 0;
    padding: var(--space-md) 0;
    border-bottom: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .works-stats > span + span {
    margin-left: var(--space-md);
    padding-left: var(--space-md);
    border-left: var(--rule-hair) solid var(--color-rule);
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .works-section {
    display: block;
  }
  .works-section > .section-head {
    margin-bottom: 0;
  }
  .works-section .section-label {
    min-width: 0;
    overflow-wrap: break-word;
  }
  .works-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .works-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 5fr) minmax(0, 6fr);
    column-gap: var(--gap-columns);
    align-items: baseline;
    padding: var(--space-md) 0;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .works-year {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .works-year .unverified {
    color: var(--color-ink-2);
  }
  .works-body {
    display: contents;
  }
  .works-title {
    grid-column: 2;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.25;
    color: var(--color-ink);
    text-decoration-color: var(--color-rule-2);
    overflow-wrap: break-word;
    min-width: 0;
  }
  a.works-title:hover {
    text-decoration-color: var(--color-accent);
  }
  .works-meta {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-sm);
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .works-meta > * + * {
    padding-left: var(--space-sm);
    border-left: var(--rule-hair) solid var(--color-rule);
  }
  .works-alias {
    color: var(--color-ink-2);
  }
  .works-status--in-progress {
    color: var(--color-accent);
  }
  .works-notes {
    grid-column: 3;
    grid-row: 1 / span 2;
    max-width: 60ch;
    color: var(--color-ink-2);
  }
  @media (max-width: 60rem) {
    .works-entry {
      grid-template-columns: minmax(0, 1fr) minmax(0, 4fr);
      row-gap: var(--space-2xs);
    }
    .works-notes {
      grid-column: 2;
      grid-row: auto;
    }
  }
</style>
