---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const entries = (await getCollection('writing', ({ data }) => data.published !== false)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout title="Writing | Ray Weiss">
  <main class="px-6 py-24 lg:px-16">
    <div class="mx-auto max-w-3xl">
      <header class="page-heading"><h1>Writing</h1></header>
      <ul class="writing-index space-y-10">
        {
          entries.map((entry) => (
            <li>
              <h2 class="font-serif text-2xl text-foreground">
                <a href={`/writing/${entry.id}`}>{entry.data.title}</a>
              </h2>
              <p class="mt-3 font-mono text-xs uppercase tracking-wider text-muted">
                <time datetime={entry.data.publishDate.toISOString()}>
                  {entry.data.publishDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
                {entry.data.readingTime && (
                  <>
                    <span class="mx-3 text-subtle">·</span>
                    <span>{entry.data.readingTime}</span>
                  </>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</BaseLayout>
