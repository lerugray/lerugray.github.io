---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Field Trials · Ray Weiss</title>
    <meta
      name="description"
      content="Playable preview builds of games in development. Contents of the Field Trials directory."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://lerugray.github.io/field-trials/" />
    <style is:inline>
      /* Hallmark · shape: Long Document (pages), Index-First (/) · genre: editorial · theme: Specimen (deal 1/3, seed personal-brooklyn-wargame-designer-8be8·276607cb·2026-10-29·r0) · redesign: full · job: hire
       * hero: Banner (pages, /writing), Settled (/) · nav: edge-aligned, the counter and wordmark left, seven links and the contact address right · footer: index columns (a real sitemap of 37 pages), then contact and a colophon · imagery: the product, Ray's own captures and covers, no library photographs · signature: the name set at poster size in Bodoni with ink-blue guides at its cap height and baseline
       * axes: light/high-contrast-serif/cool · posture: restrained · contrast: pass · fold: pass · copy: verbatim · v2.0.0 */
      /* Hallmark · pre-emit critique: P4 H5 E4 S4 R5 V4 · weakest: S, the Specimen material belongs to a foundry; the RW unit counter, the dated essay index and Ray's own module captures carry the specificity */
      /* Hallmark · hero-review: fix · 5 findings · 3 resolved 2 partial (the nav repeats the location and the address on /, the statement runs past the action) */
      /* Hallmark · waive 79 · document pages open on a Banner and their prose starts under it inside the same frame, above the fold · the render tier counts only section boundaries, so the essay and product text that follows the banner reads to it as empty paper */
      /* Hallmark · waive 49b · entry titles in the essay, business and catalog indexes are names that cannot shorten, two lines at most on a phone · essay titles and game names are Ray's own and wrap rather than truncate */
      /* Hallmark · waive 39b · Play and Send stand 48px; only the twelve roster cells on Field Trials run taller · each roster cell is the specimen of one build, its name set in Bodoni over its register, and selecting it fills the cell ink */
    </style>
  </head>
  <body>
    <SiteHeader />
    <div class="site-page">
      <div class="page-content">
        <main class="landing-index">
          <header class="page-heading">
            <h1>Field Trials</h1>
            <p class="dek">Games in development, running live in your browser.</p>
          </header>
          <p class="lede">
            This is the contents page for the directory. Every build below opens and plays in the
            browser, with no download and no account. The cabinet itself, with specimen figures,
            published test counts, pre-release audits and the field report box, is on
            <a href="/games/">the Field Trials page</a>.
          </p>

          <header class="section-head">
            <span>Builds</span>
            <span class="section-count">12 in trial</span>
          </header>

          <ol class="entries">
            <li>
              <span class="index">No.01</span>
              <span>
                <a class="entry-title" href="https://lerugray.github.io/chp-preview/"
                  >Chapel Perilous</a
                >
                <span class="meta"
                  >First-person grid crawler <span class="off">· hosted off-site</span></span
                >
              </span>
            </li>
            <li>
              <span class="index">No.02</span>
              <span>
                <a class="entry-title" href="https://i2-preview.pages.dev/">Innsmouth 2000</a>
                <span class="meta">City builder <span class="off">· hosted off-site</span></span>
              </span>
            </li>
            <li>
              <span class="index">No.03</span>
              <span>
                <a class="entry-title" href="/field-trials/stray-squadron/">Stray Squadron</a>
                <span class="meta">On-rails roguelite shooter</span>
              </span>
            </li>
            <li>
              <span class="index">No.04</span>
              <span>
                <a class="entry-title" href="/field-trials/oddseedz/">Oddseedz</a>
                <span class="meta">Monster-ranching browser toy</span>
              </span>
            </li>
            <li>
              <span class="index">No.05</span>
              <span>
                <a class="entry-title" href="/field-trials/lines-of-advance/">Lines of Advance</a>
                <span class="meta">Strategy engine</span>
              </span>
            </li>
            <li>
              <span class="index">No.06</span>
              <span>
                <a class="entry-title" href="/field-trials/capriole/">Capriole</a>
                <span class="meta">Ascent platformer</span>
              </span>
            </li>
            <li>
              <span class="index">No.07</span>
              <span>
                <a class="entry-title" href="/field-trials/shoeleather/">Shoeleather</a>
                <span class="meta">Inverted-mystery deduction</span>
              </span>
            </li>
            <li>
              <span class="index">No.08</span>
              <span>
                <a class="entry-title" href="/field-trials/jacquard-index/">The Jacquard Index</a>
                <span class="meta">No-guess nonogram catalog</span>
              </span>
            </li>
            <li>
              <span class="index">No.09</span>
              <span>
                <a class="entry-title" href="/field-trials/alkahest/">Alkahest</a>
                <span class="meta">Match-panel roguelite</span>
              </span>
            </li>
            <li>
              <span class="index">No.10</span>
              <span>
                <a class="entry-title" href="/field-trials/office-of-the-road/"
                  >The Office of the Road</a
                >
                <span class="meta">Expedition ledger sim</span>
              </span>
            </li>
            <li>
              <span class="index">No.11</span>
              <span>
                <a class="entry-title" href="/field-trials/popinjay/">Popinjay</a>
                <span class="meta">Arcade sharpshooter</span>
              </span>
            </li>
            <li>
              <span class="index">No.12</span>
              <span>
                <a class="entry-title" href="/field-trials/material-breach/">Material Breach</a>
                <span class="meta">Reverse dungeon admin</span>
              </span>
            </li>
          </ol>

          <nav class="back" aria-label="Site">
            <a href="/games/">The cabinet</a>
            <a href="/">Ray Weiss</a>
          </nav>
        </main>
      </div>
    </div>
    <SiteFooter />
    <style is:global>
      html,
      body {
        overflow-x: clip;
      }
    </style>
  </body>
</html>
