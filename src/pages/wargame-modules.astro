---
import SpecLayout from '@/layouts/SpecLayout.astro';

// Titles whose designer or publisher asked not to be adapted (Terms section). Add { title, by } when a request arrives.
const optedOut: { title: string; by: string }[] = [];
---

<SpecLayout
  title="Wargame Modules · Ray Weiss"
  description="Commissioned digital modules of print wargames: rules-enforced engines, real maps and counters, a computer opponent in the price, playable in a browser from a double-click. $400 to $800 by scope."
>
  <div class="meta-strip">
    <div class="container meta-strip__inner">
      <p class="meta-facts">
        <span>Digital modules</span>
        <span>Commissions open, selective</span>
        <span>$400 to monster</span>
        <span>Brooklyn, NY</span>
      </p>
      <a class="meta-strip__link" href="#pricing">Pricing</a>
    </div>
  </div>

  <main>
    <!-- FIRST SCREEN (1440x900): Title, Dek, Intro, Price Range, Email CTA, and Real Screenshot Proof -->
    <section class="hero-dossier">
      <div class="container hero-dossier__container">
        <div class="hero-dossier__grid">
          <div class="hero-brief">
            <div class="title-group">
              <h1 class="page-title">Wargame Modules</h1>
              <p class="page-dek">Print wargames. Running locally in a browser.</p>
            </div>

            <p class="hero-intro">
              I build digital modules of print wargames on commission. The map, the counters, and
              the procedures are translated into a local engine. You unzip a folder and double-click
              index.html. It runs in your browser. No installs, no accounts, no internet connection
              required. If you have no one to play, the module can play the other side.
            </p>

            <div class="commission-dispatch">
              <div class="dispatch-tiers" aria-label="Pricing overview">
                <div class="dispatch-tier">
                  <span class="dispatch-tier__price">$400</span>
                  <span class="dispatch-tier__name">Smaller games</span>
                </div>
                <div class="dispatch-tier">
                  <span class="dispatch-tier__price">$600</span>
                  <span class="dispatch-tier__name">Standard operational</span>
                </div>
                <div class="dispatch-tier">
                  <span class="dispatch-tier__price">$800</span>
                  <span class="dispatch-tier__name">Complex</span>
                </div>
                <div class="dispatch-tier">
                  <span class="dispatch-tier__price">Quoted</span>
                  <span class="dispatch-tier__name">Monster games</span>
                </div>
              </div>

              <div class="dispatch-cta-row">
                <a class="btn-primary" href="mailto:rweiss@consimsltd.com">Email me</a>
                <div class="dispatch-email-block">
                  <a class="dispatch-email-link" href="mailto:rweiss@consimsltd.com"
                    >rweiss@consimsltd.com</a
                  >
                  <span class="dispatch-subnote">
                    <span>$400 to monster</span>
                    <span><a href="#pricing">Pricing</a></span>
                    <span><a href="#terms">Terms</a></span>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="hero-proof">
            <figure class="screen-plate screen-plate--hero" data-kind="product">
              <div class="screen-plate__frame">
                <img
                  src="/images/wargame-modules/nab-crop.webp"
                  loading="eager"
                  width="1600"
                  height="1000"
                  alt="Napoleon at Bay digital module. Hex map of the Champagne countryside with marshal counters, and a turn control panel showing weather, morale, and the segment sequence."
                />
              </div>
              <figcaption class="screen-plate__caption">
                <span
                  >Napoleon at Bay. Turn control, weather, morale, and the segment sequence on the
                  digitized map.</span
                >
              </figcaption>
            </figure>
          </div>
        </div>

        <div class="includes-ledger">
          <h2 class="includes-ledger__title">What a module includes</h2>
          <p class="includes-ledger__body">
            Automated bookkeeping and chart lookups. Hotseat play with information masking for cards
            and hidden movement. Every roll logs the cited rule. Games save to local files. The
            price includes a computer opponent that can take either side.
          </p>
        </div>

        <div class="stat-ribbon" aria-label="Track record figures">
          <div class="stat-cell">
            <span class="stat-pip" aria-hidden="true"></span><span>7 commissions</span>
          </div>
          <div class="stat-cell">
            <span class="stat-pip" aria-hidden="true"></span><span>4 clients</span>
          </div>
          <div class="stat-cell">
            <span class="stat-pip" aria-hidden="true"></span><span>since July 2026</span>
          </div>
          <div class="stat-cell">
            <span class="stat-pip" aria-hidden="true"></span><span>600 automated rules checks</span>
          </div>
          <div class="stat-cell">
            <span class="stat-pip" aria-hidden="true"></span><span>previews within 2 days</span>
          </div>
        </div>
      </div>
    </section>

    <!-- TRACK RECORD & COMMISSIONED MODULE SCREENSHOTS -->
    <section class="dossier-section" id="track-record">
      <div class="container">
        <div class="track-record-card">
          <h2 class="track-record-card__heading">Track record</h2>
          <p class="track-record-card__body">
            Seven commissions for four clients since July 2026: Napoleon at Bay, Flattop, Paths of
            Glory, For the People, Bloody April, and two private tabletop builds. The first client
            ordered a second pair after testing the first two. Card-driven engines pass six hundred
            automated rules checks before delivery. Playable previews arrive within two days of
            commission.
          </p>
        </div>

        <figure class="screen-plate screen-plate--full" data-kind="product">
          <div class="screen-plate__frame">
            <img
              src="/images/wargame-modules/flattop-crop.webp"
              loading="lazy"
              width="1600"
              height="1128"
              alt="Flattop digital module. Search-board hexes over the Solomons with an umpire traffic panel reporting air operations by teletype."
            />
          </div>
          <figcaption class="screen-plate__caption">
            <span
              >Flattop. The umpire reports contacts by teletype. Hidden movement stays hidden.</span
            >
          </figcaption>
        </figure>

        <div class="plates-duo-grid plates-duo-grid--pog-ftp">
          <figure class="screen-plate" data-kind="product">
            <div class="screen-plate__frame">
              <img
                src="/images/wargame-modules/pog-crop.webp"
                loading="lazy"
                width="1020"
                height="1200"
                alt="Paths of Glory digital module. The Central Powers card hand beside the eastern map edge, each card offering operations or event play."
              />
            </div>
            <figcaption class="screen-plate__caption">
              <span
                >Paths of Glory. The Central Powers hand, each card playable for ops or event
                through the engine.</span
              >
            </figcaption>
          </figure>

          <figure class="screen-plate" data-kind="product">
            <div class="screen-plate__frame">
              <img
                src="/images/wargame-modules/ftp-crop.webp"
                loading="lazy"
                width="1600"
                height="1100"
                alt="For the People digital module. Point-to-point Civil War map with armies and forts, and the Confederate hand of four strategy cards beside it."
              />
            </div>
            <figcaption class="screen-plate__caption">
              <span
                >For the People. The point-to-point map with armies, forts, and the Confederate
                hand.</span
              >
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- FROM A CLIENT: BLOODY APRIL CASE STUDY & FULL TESTIMONIAL -->
    <section class="client-dossier" id="from-a-client">
      <div class="container">
        <div class="client-case">
          <div class="section-bar">
            <h2 class="section-heading">From a client</h2>
          </div>

          <div class="client-intro-row">
            <p class="client-intro-text">
              Bloody April is GMT's game of the 1917 air war over Arras: flights of aircraft at
              different altitudes, sighting rules, and movement unlike a standard hex-and-counter
              game. David Greenwood commissioned the module and a computer opponent that plays either
              side.
            </p>
          </div>

          <div class="bloody-april-plates">
            <figure class="screen-plate" data-kind="product">
              <div class="screen-plate__frame">
                <img
                  src="/images/wargame-modules/bloody-april-board.webp"
                  loading="lazy"
                  width="1600"
                  height="1082"
                  alt="Bloody April digital module. Operational map of the Arras front with German flights and British contacts, a flight-movement panel showing altitude, and the sequence of play."
                />
              </div>
              <figcaption class="screen-plate__caption">
                <span
                  >Bloody April. Flights, altitude, and the sequence of play on the Arras map.</span
                >
              </figcaption>
            </figure>

            <figure class="screen-plate" data-kind="product">
              <div class="screen-plate__frame">
                <img
                  src="/images/wargame-modules/bloody-april-ai.webp"
                  loading="lazy"
                  width="1600"
                  height="794"
                  alt="Bloody April digital module. Operations log of computer-opponent decisions and a resolved air combat, each entry citing its rule section."
                />
              </div>
              <figcaption class="screen-plate__caption">
                <span
                  >Bloody April. The computer opponent's moves and a resolved air combat in the phase
                  record, with rule citations.</span
                >
              </figcaption>
            </figure>
          </div>
        </div>

        <figure class="testimonial-monument">
          <figcaption class="testimonial-monument__header">
            <span class="testimonial-attribution"
              ><span class="testimonial-name">David Greenwood,</span>{' '}<span class="testimonial-commission">Bloody April commission</span
              ></span
            >
          </figcaption>
          <blockquote class="testimonial-body">
            <p class="testimonial-body__lead-para">
              <span class="testimonial-lead-sentence"
                >I highly recommend Ray's work at developing AI opponents for wargames.</span
              > I presented him with the challenge of Bloody April, a WWI operational air war game. This
              game is quite complex, and while it is a hex and counter game, it is very different from
              standard hex and counter games. It includes multilevel flight of groups of planes, sighting
              rules and unusual movement rules. In order to create an AI, Ray had to first digitize the
              game. He took it on enthusiastically, and the result is I can now play a favorite game that
              I have had trouble finding human opponents for. The AI is a challenging opponent and can
              play either side.
            </p>
            <p>
              Working with Ray has been great. He gave frequent updates, was open to suggestions and
              requests, and was very accommodating. He developed an innovative approach to testing,
              using a panel of AI developers to simulate games and then rate the results. This
              enabled him to go through cycles of development and testing in a very short amount of
              time.
            </p>
            <p>
              This was a VERY complex project due to its atypical rules. If someone wants a standard
              SPI-like or other standard hex and counter ground wargame, he can complete it within
              days. <span class="testimonial-closing-sentence"
                >Either way, given what it would cost to have a developer do similar work, it is a
                bargain.</span
              >
            </p>
          </blockquote>
        </figure>
      </div>
    </section>

    <!-- PRICING (4 TIERS) -->
    <section class="dossier-section" id="pricing">
      <div class="container">
        <div class="section-bar">
          <h2 class="section-heading">Pricing</h2>
        </div>

        <div class="pricing-grid">
          <article class="pricing-tier">
            <p class="pricing-tier__amount">$400</p>
            <h3 class="pricing-tier__title">Smaller games</h3>
            <p class="pricing-tier__scope">Single map, limited counter mix</p>
            <p class="pricing-tier__detail">Chart-driven procedures. No card deck.</p>
          </article>

          <article class="pricing-tier">
            <p class="pricing-tier__amount">$600</p>
            <h3 class="pricing-tier__title">Standard operational</h3>
            <p class="pricing-tier__scope">Full map, card deck or comparable subsystems</p>
            <p class="pricing-tier__detail">The Napoleon at Bay class.</p>
          </article>

          <article class="pricing-tier">
            <p class="pricing-tier__amount">$800</p>
            <h3 class="pricing-tier__title">Complex</h3>
            <p class="pricing-tier__scope">
              Hidden information, complicated mapping, layered mechanics
            </p>
            <p class="pricing-tier__detail">
              The Flattop, Paths of Glory, and For the People class: double-blind umpiring,
              extensive decks, dense hexside and connection work.
            </p>
          </article>

          <article class="pricing-tier">
            <p class="pricing-tier__amount">Quoted</p>
            <h3 class="pricing-tier__title">Monster games</h3>
            <p class="pricing-tier__detail">
              Multiple maps, thousands of counters, campaign scale.
            </p>
          </article>
        </div>

        <p class="pricing-terms-note">
          You pay half up front to reserve the build spot, half on completion. Thirty days of
          reasonable feature requests and bug fixes after delivery are included.
        </p>
      </div>
    </section>

    <!-- TRY ONE: THE WORLD UNDONE -->
    <section class="dossier-section" id="try-one">
      <div class="container">
        <div class="section-bar">
          <h2 class="section-heading">Try one</h2>
        </div>

        <p class="try-one-lead">
          The World Undone is my own published design through Conflict Simulations. Its Deluxe
          Digital edition, on itch.io, covers East Prussia, Galicia, Serbia, and the combined East
          Front campaign, hotseat or against the computer. The free East Prussia playtest build is
          the same product class I deliver for commissions: a rules-enforced engine, hex map,
          counters, and hotseat play. Open it in your browser and play.
        </p>

        <div class="plates-duo-grid plates-duo-grid--twu">
          <figure class="screen-plate" data-kind="product">
            <a class="screen-plate__frame"
              href="https://conflict-simulations-llc.itch.io/the-world-undone"
              target="_blank"
              rel="noopener"
            >
              <img
                src="/images/wargame-modules/twu-deluxe.webp"
                loading="lazy"
                width="1600"
                height="1226"
                alt="The World Undone Deluxe Digital, Galicia campaign, turn 9. Hex map with Russian and Austro-Hungarian counters, the turn track, victory points, and the combat results table."
              />
            </a>
            <figcaption class="screen-plate__caption">
              <a
                href="https://conflict-simulations-llc.itch.io/the-world-undone"
                target="_blank"
                rel="noopener">The World Undone: East Front Trilogy, Deluxe Digital on itch.io</a
              >
            </figcaption>
          </figure>

          <figure class="screen-plate" data-kind="product">
            <a class="screen-plate__frame"
              href="https://twu-ep-pt-dba90a.pages.dev/"
              target="_blank"
              rel="noopener"
            >
              <img
                src="/images/wargame-modules/twu-demo.webp"
                loading="lazy"
                width="1600"
                height="1000"
                alt="1914: East Prussia: The World Undone in play. Full hex map of East Prussia with German and Russian counters, turn track, victory point track, and combat results table."
              />
            </a>
            <figcaption class="screen-plate__caption">
              <a href="https://twu-ep-pt-dba90a.pages.dev/" target="_blank" rel="noopener"
                >Play the East Prussia 1914 playtest</a
              >
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- TERMS (EXACT LEGAL WORDING) -->
    <section class="dossier-section" id="terms">
      <div class="container">
        <div class="section-bar">
          <h2 class="section-heading">Terms</h2>
        </div>

        <div class="terms-sheet">
          <div class="terms-preamble">
            <p>
              I do not build these to undercut designers or publishers. I build them so players who
              struggle to find an opponent get a competent, reliable one, and so I can add a little
              to my minimum-wage income. I am a designer and publisher myself, and I listen when one
              of them raises a concern.
            </p>
            <p>
              Anyone with the game and an LLM harness could build one of these today. I sell my
              experience and labor in building them. If a designer or publisher asks me in writing
              not to adapt one of their titles, I stop taking commissions for it.
            </p>
          </div>
          <ol class="terms-list">
            <li>
              <span class="term-title">Personal use only</span>
              <span class="term-description"
                >A commission is a private build for you. Do not share, resell or post the module
                files. If a build turns up in public, support for it ends and I help the publisher
                get it taken down.</span
              >
            </li>
            <li>
              <span class="term-title">You must own the game</span>
              <span class="term-description"
                >You need a print copy of the edition you name, and you show it to me before I
                start. Placing an order confirms you own it. The module lets you play the copy you
                already own.</span
              >
            </li>
            <li>
              <span class="term-title"
                >Not for games that already have a digital edition with a computer opponent</span
              >
              <span class="term-description"
                >If one exists, buy that. I decline those commissions.</span
              >
            </li>
            <li>
              <span class="term-title">Designers and publishers can opt out</span>
              <span class="term-description">
                If you designed or published a game and do not want it adapted, email
                <a href="mailto:rweiss@consimsltd.com">rweiss@consimsltd.com</a>. I add the title to
                the list below the day your email arrives, decline every commission for it from then
                on, and answer you promptly.
              </span>
            </li>
          </ol>
          <div class="terms-footer" id="opted-out">
            <p><strong>Opted-out titles:</strong> {optedOut.length === 0 ? 'None yet.' : ''}</p>
            {
              optedOut.length > 0 && (
                <ul>
                  {optedOut.map((t) => (
                    <li>
                      {t.title} ({t.by})
                    </li>
                  ))}
                </ul>
              )
            }
            <p>
              <a href="mailto:rweiss@consimsltd.com"
                >Publishers who want an official adaptation can contact me.</a
              >
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- START (CLOSING CALL TO ACTION) -->
    <section class="closing-cta">
      <div class="container">
        <div class="closing-cta__box">
          <div class="closing-cta__content">
            <h2 class="closing-cta__heading">One email starts it</h2>
            <p class="closing-cta__body">
              Email <a href="mailto:rweiss@consimsltd.com">rweiss@consimsltd.com</a>. Provide the
              game title, edition, and any specific technical requirements. If the work fits, I
              reply with scope and price. If it does not, I say so.
            </p>
          </div>
          <a class="btn-primary" href="mailto:rweiss@consimsltd.com">Email me</a>
        </div>
      </div>
    </section>
  </main>
</SpecLayout>

<style>
  /* Wargame Modules: the commissions offer page in the Specimen material.
     Hero: text on five columns, the capture on seven, the offer row ruled in ink beneath both.
     Then figures, a showcase of captures, the client case with its testimonial on the ink band,
     the price ledger under the double rule, the free build, the terms as rows, a paper close. */

  /* Meta strip: the offer's facts, parted by hairlines */
  .meta-strip {
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .meta-strip__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 3rem;
  }
  /* Each fact carries its hairline on the left; the list is pulled left by one
     separator and clipped there, so a fact that starts a line never shows one. */
  .meta-facts {
    --sep: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    row-gap: var(--space-2xs);
    margin: 0 0 0 calc(-1 * (var(--sep) + var(--rule-hair)));
    clip-path: inset(0 0 0 calc(var(--sep) + var(--rule-hair)));
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .meta-facts > span {
    margin-right: var(--sep);
    padding-left: var(--sep);
    border-left: var(--rule-hair) solid var(--color-rule);
  }
  .meta-facts > span:first-child {
    font-weight: 500;
    color: var(--color-ink);
  }
  .meta-strip__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Focus: one ring everywhere, outside what it marks */
  a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* Captures: the product, framed by a hairline, never a shadow or a device */
  .screen-plate {
    margin: 0;
    min-width: 0;
  }
  .screen-plate__frame {
    display: block;
    position: relative;
  }
  .screen-plate__frame img {
    display: block;
    width: 100%;
    height: auto;
    outline: var(--rule-hair) solid var(--color-rule);
    outline-offset: -1px;
  }
  a.screen-plate__frame {
    color: inherit;
    text-decoration: none;
  }
  a.screen-plate__frame img {
    transition: outline-color var(--dur-micro) var(--ease-out);
  }
  a.screen-plate__frame:hover img {
    outline-color: var(--color-ink-2);
  }
  a.screen-plate__frame:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .screen-plate__caption {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ==========================================================================
     Hero: one screen. Title at the picture's top, intro on its baseline,
     the offer row (action under the words, prices under the picture) below.
     ========================================================================== */
  .hero-dossier__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    column-gap: var(--gap-columns);
    row-gap: var(--space-xl);
    align-content: center;
    min-height: calc(100dvh - var(--header-h) - 3rem - 2 * var(--rule-hair));
    padding-block: var(--space-xl);
  }
  .hero-brief {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    min-width: 0;
  }
  .title-group {
    grid-column: 1 / 6;
    grid-row: 1;
    display: grid;
    align-content: start;
    gap: var(--space-md);
    padding-right: var(--space-xl);
    container-type: inline-size;
  }
  /* The title is set to its column: the longer word fills it at any width. */
  .page-title {
    max-width: none;
    font-size: clamp(var(--text-display), 22cqi, 7rem);
    line-height: 0.98;
  }
  .page-dek {
    font-size: var(--text-lead);
    line-height: 1.4;
    color: var(--color-ink);
  }
  .hero-intro {
    grid-column: 1 / 6;
    grid-row: 2;
    align-self: end;
    max-width: 56ch;
    padding-right: var(--space-xl);
    color: var(--color-ink-2);
  }
  .hero-proof {
    grid-column: 6 / -1;
    grid-row: 1 / 3;
    min-width: 0;
  }
  .screen-plate--hero .screen-plate__frame {
    height: clamp(18rem, 100dvh - 24rem, 36rem);
  }
  .screen-plate--hero img {
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  .commission-dispatch {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: subgrid;
    align-items: center;
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-ink);
  }
  .dispatch-cta-row {
    grid-column: 1 / 6;
    grid-row: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }
  .dispatch-email-block {
    display: grid;
    gap: var(--space-3xs);
    min-width: 0;
  }
  .dispatch-email-link {
    font-weight: 500;
  }
  .dispatch-subnote {
    display: flex;
    flex-wrap: wrap;
    margin-left: calc(-1 * (var(--space-sm) + var(--rule-hair)));
    /* clipped on the left only; the links' focus rings keep their room elsewhere */
    clip-path: inset(
      calc(-1 * var(--space-xs)) calc(-1 * var(--space-xs)) calc(-1 * var(--space-xs))
        calc(var(--space-sm) + var(--rule-hair))
    );
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .dispatch-subnote > span {
