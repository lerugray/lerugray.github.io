  <circle class="h" cx="104" cy="40" r="7" fill="currentColor" fill-opacity=".14" stroke="currentColor"/>
  <circle cx="58" cy="48" r="5.5" fill="currentColor"/>
  <path d="M66 78V14" stroke="currentColor" stroke-width="1.4"/>
  <path d="M66 14V6" stroke="currentColor" stroke-width="1.4" stroke-opacity=".45"/>
  <path d="M54 78h24v-6H54z" fill="currentColor" fill-opacity=".6"/>
  <rect x="62" y="68" width="8" height="10" fill="currentColor"/>`),
  'material-breach': svg(`
  <rect class="g h" x="10" y="8" width="112" height="66" stroke="currentColor"/>
  <path d="M18 16h96" stroke="currentColor" stroke-width="2.4"/>
  <path d="M18 28h96" stroke="currentColor" stroke-width="1.6"/>
  <path class="h" d="M18 31h96" stroke="currentColor"/>
  <g fill="currentColor" fill-opacity=".7">
    <rect x="20" y="38" width="52" height="1.4"/><rect x="20" y="44" width="48" height="1.4"/>
    <rect x="20" y="50" width="50" height="1.4"/><rect x="20" y="56" width="40" height="1.4"/>
  </g>
  <g fill="currentColor" fill-opacity=".85">
