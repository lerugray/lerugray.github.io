---
import BaseLayout from '@/layouts/BaseLayout.astro';
// FIELD NOTES SOURCE — read at BUILD time, not fetched at runtime, so every
// note ships in the HTML and the section works with scripts off.
// `public/field-trials/devlog.json` is GENERATED by the field-trials roster
// regen and lands here by commit; every commit to main rebuilds the site, so
// the built page is never staler than the file. NEVER hand-edit that JSON.
import devlog from '../../public/field-trials/devlog.json';

// FIELD TRIALS ROSTER — THE CABINET.
// One entry per public-preview-ready game. Add a new game here the day its
// preview build deploys, and its roster cell, detail panel, PLAY link, and
// feedback filing all render from this array. Nothing else needs a new entry.
//
// CLEAN SEAM FOR PULLED GAMES: ADVERSARY was pulled 2026-08-12 (commit
// 6b300c1 — title screen/options + enemy-facing defects). When a pulled game
// returns, re-add its roster entry with its ORIGINAL `id` (feedback threads
// key off it); nothing else needs touching.
//
// Test counts + audit verdicts are copied from the field-trials repo README
// (the published audit table) and each game's own repo log. Update them when
// a redeploy changes the suite.
interface FieldTrialGame {
  /** Stable slug. Sent as the `game` key to the feedback worker — keep it
   *  once assigned, since it's how existing feedback stays attached. */
  id: string;
  name: string;
  /** One-line description of the game. */
  description: string;
  /** Short genre/register tag shown in the roster cell and the detail readout. */
  register: string;
  /** Live preview build URL. */
  url: string;
  /** Status line, e.g. "field trial — active development". */
  status: string;
  /** Passing-test count from the game's published suite. */
  tests: number;
  /** Published pre-release audit verdict, abbreviated. Honest, not flattering. */
  audit: string;
  /** Specimen figure — the real capture shown in the detail panel when selected. */
  figure?: { src: string; alt: string; caption: string };
}

const games: FieldTrialGame[] = [
  {
    id: 'chapel-perilous',
    name: 'Chapel Perilous',
    description:
      'A first-person grid dungeon crawler set in Illuminatus!-trilogy conspiracy static.',
    register: 'First-person grid crawler',
    url: 'https://lerugray.github.io/chp-preview/',
    status: 'Field trial — active development',
    tests: 605,
    audit: 'Five-role studio audit — the build contract itself was refuted before it was built',
    figure: {
      src: '/field-trials/chapel-perilous-fig.png',
      alt: 'Chapel Perilous title screen: phosphor-green terminal text reading "a recovered operations manual" beside a party panel',
      caption: 'FIG. 1 — recovered operations manual, build 2026.08',
    },
  },
  {
    id: 'innsmouth-2000',
    name: 'Innsmouth 2000',
    description:
      'A Lovecraftian take on the classic 1993 city-builder: zone a rotting coastal town and appease five gods whose wrath is the disasters menu.',
    register: 'City builder',
    url: 'https://i2-preview.pages.dev/',
    status: 'Field trial — active development',
    tests: 417,
    audit: 'Defects found — 1 blocker, 3 defects, 3 friction, each with a repro',
    figure: {
      src: '/field-trials/innsmouth-2000-fig.png',
      alt: 'Innsmouth 2000 title screen: a beveled verdigris wordmark over a dimmed generated town with lit windows, in front of a system-dialog start menu',
      caption: 'FIG. 2 — title screen over a generated town, build 2026.08',
    },
  },
  {
    id: 'stray-squadron',
    name: 'Stray Squadron',
    description:
      'A browser-native rail shooter in the format of SNES-era Star Fox, rebuilt as a roguelite: flat-shaded low-poly ships, branching sector runs, a hub of upgrades between them. Every asset is code-generated. Best with a controller or mouse; every control is rebindable in Options.',
    register: 'On-rails roguelite shooter',
    url: 'https://ss-preview.pages.dev/',
    status: 'Field trial — active development',
    tests: 497,
    audit: 'Genre audit: no silent gaps — independent finishedness audit: NEEDS-A-ROUND',
    figure: {
      src: '/field-trials/stray-squadron-fig.png',
      alt: 'Stray Squadron title screen: bold yellow block-letter wordmark over a dark starfield, a low-poly ship beside the run menu',
      caption: 'FIG. 3 — title screen, build 2026.08',
    },
  },
  {
    id: 'oddseedz',
    name: 'Oddseedz',
    description:
      'A cozy, fully code-generated monster-ranching browser toy with 70 Buddies and no death.',
    register: 'Monster-ranching browser toy',
    url: 'https://lerugray.github.io/field-trials/oddseedz/',
    status: 'Field trial · active development',
    tests: 305,
    audit: 'NEEDS-A-ROUND, followed by a documented fix round',
    figure: {
      src: '/field-trials/oddseedz-fig-2026-08-10.png',
      alt: 'Oddseedz specimen plate: a green Buddy under a hanging lamp in a lit night toy room, moon at the window, seed vending machine on the right',
      caption: 'FIG. 4 · lit toy room, build 2026.08',
    },
  },
  {
    id: 'lines-of-advance',
    name: 'Lines of Advance',
    description:
      'A modern strategy game of supply lines and massed attacks. Symmetric armies, deterministic combat, an engine that fights. Inspired by Guy Debord’s Kriegspiel.',
    register: 'Strategy engine',
    url: 'https://lerugray.github.io/field-trials/lines-of-advance/',
    status: 'Field trial — released',
    tests: 156,
    audit: 'Release audit — all findings verified landed, 156/156 independent re-run',
    figure: {
      src: '/field-trials/lines-of-advance/og.png',
      alt: 'Lines of Advance share card: the full 25x20 board at deployment, both armies arrayed, with the unit and supply inspector panels on the right',
      caption: 'FIG. 5 — deployment, build 2026.08',
    },
  },
  {
    id: 'capriole',
    name: 'Capriole',
    description:
      'A clockwork goat falls upward. Nine toybox spheres, a carnival scorecard on every death, runs of 15–25 minutes.',
    register: 'Ascent platformer',
    url: 'https://lerugray.github.io/field-trials/capriole/',
    status: 'Field trial · active development',
    tests: 188,
    audit: 'Spawn-safety sweep — 8,000 cases, zero death loops',
    figure: {
      src: '/field-trials/capriole-fig-2026-08-11.png',
      alt: 'Capriole gameplay: the Dawn Fair teaching sphere — floating grass islands and striped clay pots against a dithered blue sky, collectible rings overhead',
      caption: 'FIG. 6 · Dawn Fair, teaching sphere, build 2026.08',
    },
  },
  {
    id: 'shoeleather',
    name: 'Shoeleather',
    description:
      'You watch the murder. Then you prove it. A 70s-TV inverted mystery — typed facts, contradiction interrogations, one shot at the gotcha.',
    register: 'Inverted-mystery deduction',
    url: 'https://lerugray.github.io/field-trials/shoeleather/',
    status: 'Field trial · active development',
    tests: 373,
    audit: 'FIX-FIRST — 18 findings, one ship-blocker (the gotcha could be brute-forced; fixed)',
    figure: {
      src: '/field-trials/shoeleather-fig-2026-08-11.png',
      alt: 'Shoeleather gameplay: painted character portraits and the typed-fact notebook of an open murder case',
      caption: 'FIG. 7 · Case one, the notebook, build 2026.08',
    },
  },
  {
    id: 'jacquard-index',
    name: 'The Jacquard Index',
    description:
      'The pattern library of Reedmoor Mill, est. 1889. Nonograms that never ask you to guess — every card proved solvable by deduction alone, one twist per drawer.',
    register: 'No-guess nonogram catalog',
    url: 'https://lerugray.github.io/field-trials/jacquard-index/',
    status: 'Field trial · active development',
    tests: 252,
    audit: 'FIX-FIRST — 8 findings; 7 fixed, 1 named omission',
    figure: {
      src: '/field-trials/jacquard-index-fig-2026-08-12.png',
      alt: 'The Jacquard Index gameplay: an open nonogram pattern card — THE LEAF — with run-length clues and the fill controls',
      caption: 'FIG. 8 · THE LEAF, pattern card, build 2026.08',
    },
  },
  {
    id: 'alkahest',
    name: 'Alkahest',
    description:
      'A match-panel machine on an alchemist’s bench. Climb the four acts of the Magnum Opus against rival signatures. Flashes are internally capped; a player-facing intensity setting is coming in a future build.',
    register: 'Match-panel roguelite',
    url: 'https://lerugray.github.io/field-trials/alkahest/',
    status: 'Field trial · active development',
    tests: 215,
    audit: 'FIX-FIRST — 6 findings; 4 fixed, 1 disclosed unfixed',
    figure: {
      src: '/field-trials/alkahest-fig-2026-08-11.png',
      alt: 'Alkahest gameplay: two populated panel wells facing off across a VS banner — the player’s bench against the rival Verdigris',
      caption: 'FIG. 9 · First bout, NIGREDO act, build 2026.08',
    },
  },
  {
    id: 'office-of-the-road',
    name: 'The Office of the Road',
    description:
      'You are the desk the heroes report to. An expedition is issued, the party marches itself, and tarot from the hand is your only intervention.',
    register: 'Expedition ledger sim',
    url: 'https://lerugray.github.io/field-trials/office-of-the-road/',
    status: 'Field trial — released',
    tests: 187,
    audit:
      'Release gate — 9-step run; QA verdict SHIP, 3 disclosed blemishes, in-gate fixes landed',
    figure: {
      src: '/field-trials/office-of-the-road/og.png',
      alt: 'The Office of the Road share card: four pixel battlers and tarot cards over the dark ledger ground',
      caption: 'FIG. 10 · field resolution, build 2026.08',
    },
  },
  {
    id: 'popinjay',
    name: 'Popinjay',
    description:
      "A single-screen arcade roguelite on Pang's bouncing-balloon core — a 1900s World's Fair sharpshooter, wire-as-wall commitment, hand-tinted poster idiom.",
    register: 'Arcade sharpshooter',
    url: 'https://lerugray.github.io/field-trials/popinjay/',
    status: 'Field trial · active development',
    tests: 281,
    audit: 'FIX-FIRST — skeptical pre-release 2026-08-12; 281/281 battery',
    figure: {
      src: '/field-trials/popinjay-fig-2026-08-18b.png',
      alt: "Popinjay gameplay: a World's Fair sharpshooter stage with balloons in flight against a hand-tinted poster ground",
      caption: 'FIG. 11 · balloons in flight, build 2026.08',
    },
  },
  {
    id: 'material-breach',
    name: 'Material Breach',
    description:
      'You run the dungeon. Adventurers are an occupational incident, filed with a root-cause analysis and a corrective-action owner.',
    register: 'Reverse dungeon admin',
    url: 'https://lerugray.github.io/field-trials/material-breach/',
    status: 'Field trial — released',
    tests: 205,
    audit:
      'Release gate — 9-step run 2026-08-18; a save-brick blocker and a phantom notice fix caught and closed in-gate; 205/205',
    figure: {
      src: '/field-trials/material-breach-fig-2026-08-18.png',
      alt: 'Material Breach opening: the CHARTER OF APPOINTMENT masthead printed on a desk document, MATERIAL BREACH as the letterhead',
      caption: 'FIG. 12 · masthead on the desk, build 2026.08',
    },
  },
];

const totalTests = games.reduce((n, g) => n + g.tests, 0);
const totalTestsFmt = totalTests.toLocaleString('en-US');

// FEEDBACK ENDPOINT — LIVE (worker deployed 2026-08-05, probe-verified).
// If it's ever unreachable, each feedback box degrades in place to
// "Feedback wire not yet connected." and the page stays presentable.
// Note: local dev renders show the degraded state (CORS allowlists the
// production origin) — that's expected, not a defect.
const FEEDBACK_ENDPOINT = 'https://field-trials-feedback.lerugray.workers.dev';

// ============================================================
// FIELD NOTES — the log under the cabinet.
// The flat list outgrew itself at 49 entries (2,000px of scroll), so the
// section now reads as: the latest few in full, then one collapsed drawer per
// build holding that build's whole history. Native <details>, no script — the
// notes are in the HTML whether or not JS runs. Adding a note anywhere in the
// devlog lands it in both places automatically; nothing here needs touching
// when the feed grows.
// ============================================================
interface DevlogEntry {
  date: string;
  game: string;
  note: string;
}

const devlogEntries: DevlogEntry[] = Array.isArray(devlog.entries) ? devlog.entries : [];

// Newest first. Dates are ISO (YYYY-MM-DD), so string compare is date order.
const fieldNotes = [...devlogEntries].sort((a, b) => b.date.localeCompare(a.date));

// How many notes stay open at the top. The rest are one click away, never gone.
const LATEST_SHOWN = 6;
const latestNotes = fieldNotes.slice(0, LATEST_SHOWN);

// Devlog game names are free text ("THE JACQUARD INDEX" vs the roster's "The
// Jacquard Index"), so group on a normalised key and keep the roster's cart id
// where one matches — that gives each drawer a link back up to its roster cell.
// Where the roster knows the game, show its name as the roster spells it, so
// the log and the cabinet name each build the same way.
const nameKey = (s: string) => s.trim().toLowerCase();
const cartIdByName = new Map(games.map((g) => [nameKey(g.name), g.id]));
const rosterNameByKey = new Map(games.map((g) => [nameKey(g.name), g.name]));
const displayGame = (s: string) => rosterNameByKey.get(nameKey(s)) ?? s;

interface NoteGroup {
  key: string;
  label: string;
  cartId: string | undefined;
  notes: DevlogEntry[];
}

const groupMap = new Map<string, NoteGroup>();
for (const entry of fieldNotes) {
  const key = nameKey(entry.game);
  let group = groupMap.get(key);
  if (!group) {
    group = { key, label: displayGame(entry.game), cartId: cartIdByName.get(key), notes: [] };
    groupMap.set(key, group);
  }
  group.notes.push(entry);
}

// Most recently worked build first — the drawer order answers "what moved".
const noteGroups = [...groupMap.values()].sort((a, b) => {
  const byDate = b.notes[0].date.localeCompare(a.notes[0].date);
  return byDate !== 0 ? byDate : b.notes.length - a.notes.length;
});

const workshopCount = typeof devlog.workshop_count === 'number' ? devlog.workshop_count : 0;
const noteCountLabel = (n: number) => `${n} ${n === 1 ? 'note' : 'notes'}`;
---

<BaseLayout
  title="Field Trials · Ray Weiss"
  description={`Playable preview builds of games in development. Pick a cartridge, press play. ${totalTestsFmt} tests and every audit published.`}
  image="/og-games.png"
>
  <header class="hero hero--plain page-heading trials-hero">
    <div>
      <h1>Field Trials</h1>
      <p class="dek">Games in development, running live in your browser.</p>
      <div class="slug" aria-label="Identification">
        <span><strong>Unit</strong> RW / 26</span>
        <span><strong>Type</strong> Preview builds</span>
        <span><strong>Scale</strong> {games.length} in trial</span>
      </div>
    </div>

    <div class="bio">
      <p>
        These are games I'm still building. Pick a cartridge below — the current build opens in your
        browser. No download, no account. Play, and if something breaks or feels off, tell me in the
        field report under the cabinet. I read every one.
      </p>
      <p>
        The process behind them is public too — every game's design seed, test suite, and
        pre-release audit lives in the
        <a href="https://github.com/lerugray/field-trials">field-trials repository</a> on GitHub.
      </p>
    </div>
  </header>

  <section aria-labelledby="roster" class="cabinet-section">
    <div class="section-head">
      <h2 class="section-label" id="roster">Roster</h2>
      <span class="section-count"
        >{games.length.toString().padStart(2, '0')}
        {games.length === 1 ? 'entry' : 'entries'}</span
      >
    </div>

    <!-- Interactive Field Trials cabinet. -->
    <div class="cabinet" id="cabinet" data-count={games.length}>
      <div class="cab-rail" aria-hidden="true">
        <span class="cab-rail-left">Specimen cabinet — select a cartridge</span>
        <span class="cab-rail-right"
          >{totalTestsFmt} tests across {games.length} builds · audits published</span
        >
      </div>

      <div class="cab-body">
        <div class="cab-shelf-col">
          <div
            class="cab-shelf"
            role="group"
            aria-label="Cartridge shelf. Click a cartridge to select it; click again to play."
          >
            {/* Each cell: the script reads the name from .sr-only for its status
                line; the visible name is the same text, hidden from assistive
                tech so it is announced once. */}
            {
              games.map((game, i) => (
                <button
                  type="button"
                  class="cart"
                  id={`cart-${game.id}`}
                  data-game={game.id}
                  data-index={i}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-describedby={`panel-${game.id}`}
                >
                  <span class="sr-only">{game.name}</span>
                  <span class="cart-name" aria-hidden="true">
                    {game.name}
                  </span>
                  <span class="cart-reg">{game.register}</span>
                </button>
              ))
            }
          </div>
          <p class="cab-hint" aria-hidden="true">
            <span><kbd>&larr;</kbd><kbd>&uarr;</kbd><kbd>&darr;</kbd><kbd>&rarr;</kbd> Browse</span>
            <span><kbd>Enter</kbd> plays</span>
          </p>
          <p class="sr-only" role="status" aria-live="polite" data-cab-status></p>
        </div>

        <div class="cab-detail">
          {
            games.map((game, i) => (
              <article
                class="cab-panel"
                id={`panel-${game.id}`}
                data-panel={game.id}
                data-active={i === 0 ? 'true' : null}
                hidden={i !== 0}
                aria-label={`${game.name} — details`}
              >
                {game.figure ? (
                  <figure class="cab-fig">
                    <div class="cab-shot">
                      <img
                        src={game.figure.src}
                        alt={game.figure.alt}
                        loading={i === 0 ? 'eager' : 'lazy'}
                        width="1200"
                        height="750"
                      />
                    </div>
                    <figcaption>{game.figure.caption}</figcaption>
                  </figure>
                ) : (
                  <div class="cab-shot cab-shot--empty">
                    <span>No signal — capture pending</span>
                  </div>
                )}

                <div class="cab-readout">
                  <h3 class="cab-title">{game.name}</h3>
                  <p class="cab-desc">{game.description}</p>

                  <dl class="cab-meta">
                    <div>
                      <dt>Register</dt>
                      <dd>{game.register}</dd>
                    </div>
                    <div>
                      <dt>Status</dt>
                      <dd>{game.status}</dd>
                    </div>
                    <div>
                      <dt>Suite</dt>
                      <dd>
                        <strong class="cab-tests">{game.tests}</strong> tests passing
                      </dd>
                    </div>
                  </dl>

                  <p class="cab-audit">
                    <span class="k">Pre-release audit</span>
                    {game.audit}
                  </p>

                  <a
                    href={game.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary cab-play"
                    data-play={game.id}
                  >
                    Play
                    <span class="cab-play-sub">opens the build in a new tab</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>

        <section class="field-report" aria-labelledby="fr-heading">
          <div class="fr-rail">
            <h3 class="fr-title" id="fr-heading">Field report — tell me what broke</h3>
            <label class="fr-select-wrap">
              <span class="fr-select-label">Filed under</span>
              <select id="fr-game" class="fr-select">
                {games.map((g) => <option value={g.id}>{g.name}</option>)}
              </select>
            </label>
          </div>
          <div class="feedback-box" data-endpoint={FEEDBACK_ENDPOINT} data-game={games[0].id}>
            <p class="feedback-status" hidden></p>
            <ol class="feedback-list" aria-label="Feedback for the selected game"></ol>
            <form class="feedback-form" aria-label="Send feedback for the selected game">
              <div class="feedback-honeypot" aria-hidden="true">
                <label>
                  Leave this field blank
                  <input type="text" name="website" tabindex={-1} autocomplete="off" />
                </label>
              </div>
              <div class="feedback-field">
                <label class="feedback-label" for="ft-name">
                  Name <span class="feedback-optional">(optional)</span>
                </label>
                <input
                  type="text"
                  id="ft-name"
                  name="name"
                  maxlength="40"
                  class="feedback-input"
                  autocomplete="name"
                />
              </div>
              <div class="feedback-field">
                <label class="feedback-label" for="ft-body">Feedback</label>
                <textarea
                  id="ft-body"
                  name="body"
                  maxlength="1000"
                  rows="3"
                  required
                  class="feedback-textarea"
                  placeholder="What happened? What would you change?"></textarea>
              </div>
              <div class="feedback-row">
                <button type="submit" class="feedback-submit">Send</button>
                <p class="feedback-note" role="status" aria-live="polite"></p>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
    <noscript>
      <style>
        .cab-panel[hidden] {
          display: block !important;
        }
        .cab-hint {
          display: none;
        }
      </style>
    </noscript>
  </section>

  {
    fieldNotes.length > 0 && (
      <section id="field-notes" class="field-notes" aria-labelledby="field-notes-heading">
        <div class="section-head">
          <h2 class="section-label" id="field-notes-heading">
            Field notes
          </h2>
          <span class="section-count">
            {fieldNotes.length.toString().padStart(2, '0')}{' '}
            {fieldNotes.length === 1 ? 'note' : 'notes'}
          </span>
        </div>

        <div class="fn-latest">
          <p class="fn-lede">
            The most recent work, then every build's full log in its own drawer.
          </p>

          <ol class="field-notes-list" aria-label="Most recent Field Trials development notes">
            {latestNotes.map((entry) => (
              <li class="field-notes-row">
                <span class="field-notes-meta">
                  <span class="fn-date">{entry.date}</span>
                  <span class="fn-game">{displayGame(entry.game)}</span>
                </span>
                <span class="fn-note">{entry.note}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="fn-builds">
          <div class="fn-builds-head">
            <h3 class="fn-sub" id="fn-by-build">
              By build
              <span class="fn-sub-count">
                {noteGroups.length} builds · {fieldNotes.length} notes
              </span>
            </h3>
          </div>

          <div class="fn-groups">
            {noteGroups.map((group) => (
              <details class="fn-group">
                <summary class="fn-sum">
                  <span class="fn-sum-name">{group.label}</span>
                  <span class="fn-sum-meta">
                    <span>{noteCountLabel(group.notes.length)}</span>
                    <span>latest {group.notes[0].date}</span>
                  </span>
                </summary>
                <div class="fn-group-body">
                  <ol class="fn-group-list" aria-label={`${group.label} development notes`}>
                    {group.notes.map((entry) => (
                      <li class="fn-group-row">
                        <span class="fn-date">{entry.date}</span>
                        <span class="fn-note">{entry.note}</span>
                      </li>
                    ))}
                  </ol>
                  {group.cartId && (
                    <a class="fn-cart-link" href={`#cart-${group.cartId}`}>
                      See the cartridge
                    </a>
                  )}
                </div>
              </details>
            ))}
          </div>

          {workshopCount > 0 && (
            <p class="field-notes-workshop">{workshopCount} more in the workshop.</p>
          )}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Field Trials in the Specimen material. The twelve builds are set as a
     character set: hairline cells, each holding a name in Bodoni and its
     register, the selected cell filled ink. Its specimen sits beside it: the
     real capture under a 1px rule, the facts as a ruled list, the audit in a
     paper well, and Play as the page's one ink action. No device, no glow. */

  /* ---------------- Hero: the statement under the title ---------------- */

  .trials-hero > .bio {
    display: block;
    grid-column: 5 / -1;
    margin-top: var(--space-xl);
  }

  /* ---------------- The cabinet ---------------- */

  .cab-rail {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-lg);
    margin-top: var(--space-xl);
    padding-bottom: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
  }
  .cab-rail-right {
    font-variant-numeric: tabular-nums;
  }

  /* Seven columns of cells beside a five-column specimen; the field report
     sits under the cells. The second row is flexible so a tall specimen
     never pushes the report away from the cells. */
  .cab-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto minmax(0, 1fr);
    column-gap: var(--gap-columns);
    row-gap: var(--space-xl);
    align-items: start;
  }
  .cab-shelf-col {
    grid-column: 1 / span 7;
    grid-row: 1;
    min-width: 0;
  }
  .cab-detail {
    grid-column: 8 / -1;
    grid-row: 1 / span 2;
    min-width: 0;
    /* Sticky, NOT its own scroll region: the page owns the only scroll
       context (Ray, 2026-08-12 — the inner overflow made a wheel trap). */
    position: sticky;
    top: var(--space-xl);
  }
  .field-report {
    grid-column: 1 / span 7;
    grid-row: 2;
    min-width: 0;
  }

  /* The character set. Cells share one hairline: the shelf draws the top and
     left edges, each cell its right and bottom. The cells stand taller than
     the 44 to 52px control band on purpose: each is the specimen of one build
     (its name in Bodoni over its register). Play and Send keep 48px. */
  .cab-shelf {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--rule-hair) solid var(--color-rule-2);
    border-left: var(--rule-hair) solid var(--color-rule-2);
  }
  @media (min-width: 80rem) {
    .cab-shelf {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .cart {
    appearance: none;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-sm);
    min-width: 0;
    aspect-ratio: 1 / 1;
    margin: 0;
    padding: var(--space-md);
    border: 0;
    border-right: var(--rule-hair) solid var(--color-rule-2);
    border-bottom: var(--rule-hair) solid var(--color-rule-2);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out);
  }
  .cart-name {
    display: block;
    min-width: 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: var(--display-weight);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    overflow-wrap: break-word;
  }
  .cart-reg {
    display: block;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-muted);
    transition: color var(--dur-micro) var(--ease-out);
  }
  .cart:hover {
    background: var(--color-hover-well);
  }
  .cart:active {
    background: var(--color-paper-3);
  }
  /* The current cell fills ink. */
  .cart[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-band-ink);
  }
  .cart[aria-pressed='true'] .cart-reg {
    color: var(--color-band-muted);
  }
  .cart[aria-pressed='true']:hover {
    background: var(--color-ink-2);
  }
  .cart:focus-visible {
    z-index: var(--z-base);
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  /* Arriving from a field-notes "See the cartridge" link (#cart-<id>): mark
     where you landed. Pure CSS, so it reads with scripts off too. */
  .cart:target {
    z-index: var(--z-base);
    outline: 2px solid var(--color-accent);
    outline-offset: -6px;
  }

  .cab-hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-lg);
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .cab-hint > span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .cab-hint kbd {
    min-width: 1.5em;
    font-size: var(--text-xs);
    text-align: center;
    color: var(--color-ink-2);
  }

  /* ---------------- The specimen ---------------- */

  .cab-panel {
    display: grid;
    gap: var(--space-lg);
  }
  .cab-fig {
    margin: 0;
  }
