// FEEDBACK ENDPOINT — LIVE (worker deployed 2026-08-05, probe-verified).
// If it's ever unreachable, each feedback box degrades in place to
// "Feedback wire not yet connected." and the page stays presentable.
// Note: local dev renders show the degraded state (CORS allowlists the
// production origin) — that's expected, not a defect.
const FEEDBACK_ENDPOINT = 'https://field-trials-feedback.lerugray.workers.dev';
---

<BaseLayout
  title="Field Trials · Ray Weiss"
  description={`Playable preview builds of games in development. Pick a cartridge, press play. ${totalTestsFmt} tests and every audit published.`}
  image="/og-games.png"
  colophon={{ sheet: 'VIII', edition: '2026.08', loc: 'Brooklyn, NY', scale: 'Live builds' }}
>
  <div
    slot="sheet-id"
    class="sheet-id"
    aria-label="Sheet identification"
  >
    <div class="plate">
      <span class="num">PL. VIII</span> Field Trials · Preview Builds
    </div>
    <div class="edition">Edition 2026.08 · Brooklyn, NY</div>
  </div>

  <div class="mx-auto max-w-4xl">
    <header class="hero hero--plain">
      <div>
        <h1>Field Trials</h1>
        <p class="dek">Games in development, running live in your browser.</p>
        <div class="slug" aria-label="Identification">
          <span><strong>UNIT</strong> RW / 26</span>
          <span class="sep">/</span>
          <span><strong>TYPE</strong> Preview builds</span>
          <span class="sep">/</span>
          <span><strong>SCALE</strong> {games.length} in trial</span>
        </div>
      </div>
    </header>

    <div class="bio">
      <p>
        These are games I'm still building. Pick a cartridge below — the current build opens in
        your browser. No download, no account. Play, and if something breaks or feels off, tell
        me in the field report under the cabinet. I read every one.
      </p>
    </div>
  </div>

  <section aria-labelledby="roster" class="cabinet-section">
    <div class="mx-auto max-w-4xl">
      <div class="section-head">
        <h2 class="section-label" id="roster">
          <span class="pl">PL. VIII</span>Roster
        </h2>
        <span class="section-count"
          >{games.length.toString().padStart(2, '0')} {games.length === 1 ? 'entry' : 'entries'} ——</span
        >
      </div>
    </div>

    <!-- THE CABINET. This plate deliberately breaks the atlas paper register
         (Ray's call, 2026-08-12): the games deserve an arcade, not a ledger.
         The seam is framed as an atlas plate; everything inside is dark. -->
    <div class="cabinet" id="cabinet" data-count={games.length}>
      <div class="cab-rail" aria-hidden="true">
        <span class="cab-rail-left">SPECIMEN CABINET — SELECT A CARTRIDGE</span>
        <span class="cab-rail-right">{totalTestsFmt} TESTS ACROSS {games.length} BUILDS · AUDITS PUBLISHED</span>
      </div>

      <div class="cab-body">
        <div class="cab-shelf-col">
          <div
            class="cab-shelf"
            role="group"
            aria-label="Cartridge shelf. Arrow keys browse, Enter plays the selected game."
          >
            {
              games.map((game, i) => (
                <button
                  type="button"
                  class="cart"
                  id={`cart-${game.id}`}
                  data-game={game.id}
                  data-index={i}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-describedby={`panel-${game.id}`}
                  style={`--shell:${game.shell}; --shell-hi:${game.shellHi}; --glow:${game.glow};`}
                >
                  <span class="cart-grip" aria-hidden="true" />
                  <span class="cart-no" aria-hidden="true">No.{(i + 1).toString().padStart(2, '0')}</span>
                  <span class="cart-label" set:html={labelArt[game.id]} />
                  <span class="cart-led" aria-hidden="true" />
                  <span class="sr-only">{game.name}</span>
                </button>
              ))
            }
          </div>
          <p class="cab-hint" aria-hidden="true">&larr; &uarr; &darr; &rarr; BROWSE &nbsp;·&nbsp; ENTER PLAYS</p>
          <p class="sr-only" role="status" aria-live="polite" data-cab-status></p>
        </div>

        <div class="cab-detail">
          {
            games.map((game, i) => (
              <article
                class="cab-panel"
                id={`panel-${game.id}`}
                data-panel={game.id}
                data-active={i === 0 ? 'true' : null}
                hidden={i !== 0}
                aria-label={`${game.name} — details`}
              >
                <div class="crt">
                  <div class="crt-top" aria-hidden="true">
                    <span class="crt-power" />
                    <span class="crt-ch">SLOT {(i + 1).toString().padStart(2, '0')}</span>
                  </div>
                  {game.figure ? (
                    <figure class="crt-fig">
                      <div class="crt-screen">
                        <img
                          src={game.figure.src}
                          alt={game.figure.alt}
                          loading={i === 0 ? 'eager' : 'lazy'}
                          width="1200"
                          height="750"
                        />
                      </div>
                      <figcaption>{game.figure.caption}</figcaption>
                    </figure>
                  ) : (
                    <div class="crt-screen crt-screen--empty">
                      <span>NO SIGNAL — capture pending</span>
                    </div>
                  )}
                </div>

                <div class="cab-readout">
                  <h3 class="cab-title">{game.name}</h3>
                  <p class="cab-desc">{game.description}</p>

                  <dl class="cab-meta">
                    <div>
                      <dt>Register</dt>
                      <dd>{game.register}</dd>
                    </div>
                    <div>
                      <dt>Status</dt>
                      <dd>{game.status}</dd>
                    </div>
                    <div>
                      <dt>Suite</dt>
                      <dd>
                        <strong class="cab-tests">{game.tests}</strong> tests passing
                      </dd>
                    </div>
                  </dl>

                  <p class="cab-audit">
                    <span class="k">Pre-release audit</span>
                    {game.audit}
                  </p>

                  <a
                    href={game.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cab-play"
                    data-play={game.id}
                  >
                    <span class="tri" aria-hidden="true">&#9654;</span> PLAY
                    <span class="cab-play-sub">opens the build in a new tab</span>
                  </a>

                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
    <section class="field-report" aria-labelledby="fr-heading">
      <div class="fr-rail">
        <h3 class="fr-title" id="fr-heading">FIELD REPORT — TELL ME WHAT BROKE</h3>
        <label class="fr-select-wrap">
          <span class="fr-select-label">FILED UNDER</span>
          <select id="fr-game" class="fr-select">
            {games.map((g) => <option value={g.id}>{g.name}</option>)}
          </select>
        </label>
      </div>
      <div class="feedback-box" data-endpoint={FEEDBACK_ENDPOINT} data-game={games[0].id}>
        <p class="feedback-status" hidden />
        <ol class="feedback-list" aria-label="Feedback for the selected game" />
        <form class="feedback-form" aria-label="Send feedback for the selected game">
          <div class="feedback-honeypot" aria-hidden="true">
            <label>
              Leave this field blank
              <input type="text" name="website" tabindex={-1} autocomplete="off" />
            </label>
          </div>
          <div class="feedback-field">
            <label class="feedback-label" for="ft-name">
              Name <span class="feedback-optional">(optional)</span>
            </label>
            <input type="text" id="ft-name" name="name" maxlength="40" class="feedback-input" autocomplete="name" />
          </div>
          <div class="feedback-field">
            <label class="feedback-label" for="ft-body">Feedback</label>
            <textarea
              id="ft-body"
              name="body"
              maxlength="1000"
              rows="3"
              required
              class="feedback-textarea"
              placeholder="What happened? What would you change?"
            />
          </div>
          <div class="feedback-row">
            <button type="submit" class="feedback-submit">Send</button>
            <p class="feedback-note" role="status" aria-live="polite" />
          </div>
        </form>
      </div>
    </section>
    <noscript>
      <style>
        .cab-panel[hidden] {
          display: block !important;
        }
        .cab-hint {
          display: none;
        }
      </style>
    </noscript>
  </section>

  <div class="mx-auto max-w-4xl">
    <section
      id="field-notes"
      class="field-notes"
      aria-labelledby="field-notes-heading"
      hidden
    >
      <div class="section-head">
        <h2 class="section-label" id="field-notes-heading">
          <span class="pl">PL. VIII</span>Field notes
        </h2>
        <span class="section-count" data-field-notes-count></span>
      </div>
      <ol class="field-notes-list" aria-label="Field Trials development notes"></ol>
      <p class="field-notes-workshop" data-field-notes-workshop hidden></p>
    </section>

    <div class="hex-rule" aria-hidden="true">
      <img src="/hex-ornament.svg" alt="" width="96" height="32" />
    </div>
  </div>
</BaseLayout>

<style>
  /* ============================================================
     PAGE GROUND — full dark room for this plate only.
     Decision: vault/decisions/2026-08-12-games-page-dark-ground.md
     Scoping: these :global(:root)/html/body rules ship ONLY on /games
     (Astro emits this <style> solely for this page). No BaseLayout or
     global.css changes; other pages keep the paper register.
     ============================================================ */
  :global(:root) {
    --color-background: #0c0b09;
    --color-surface: #14120e;
    --color-frame: #1f1b14;
    --color-border: #2c261b;
    --color-rule: #6b6350;
    --color-foreground: #e8dfc8;
    --color-muted: #cfc5a9;
    --color-subtle: #8f8468;
    --color-link: #d4c49a;
    --color-link-hover: #f3ecd6;
    --color-accent: #e8a13c;
    --color-blue-tick: #9db8e8;
  }
  :global(html) {
    background: #0c0b09;
    color: #e8dfc8;
  }
  /* Multiply grain on parchment goes black on near-black; soft-light keeps texture. */
  :global(body::after) {
    opacity: 0.2;
    mix-blend-mode: soft-light;
  }
  :global(body::before) {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9998;
    background: radial-gradient(
      ellipse 85% 70% at 50% 30%,
      transparent 45%,
      rgb(0 0 0 / 0.4) 100%
    );
  }

  /* Outermost plate seams only — soften the atlas double-frame that
     existed to sit on parchment. Nothing inside the cabinet changes. */
  .cabinet,
  .field-report {
    border-color: #2c261b;
    outline-color: #1a1712;
  }

  /* Hex ornament strokes are ink (#1f1b14); invert so they read on dark. */
  .hex-rule :global(img) {
    filter: invert(1);
    opacity: 0.45;
  }

  /* ============================================================
     THE CABINET — deliberate register break for this plate only.
     Decision record: vault/decisions/2026-08-12-arcade-shelf-games-page.md
     Cabinet palette tokens (scoped here, not in the site theme):
       ink-box   #14120e   cabinet ground (kin to --color-foreground)
       plank     #241d14 / #0c0a07   shelf wood-dark
       lamp      #e8a13c   power amber — PLAY, LEDs, selection heat
       paper     #e8dfc8   the site's parchment, used as light
     ============================================================ */

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .cabinet-section {
    margin-top: 8px;
  }
  @media (min-width: 1024px) {
    /* Break the cabinet out of the 920px prose column: main is left-aligned
       against the sidebar, so the unused space is all on the right — grow
       into it (viewport - 280px sidebar - main's 64px+64px padding), capped. */
    .cabinet-section {
      width: min(1160px, calc(100vw - 280px - 128px));
      max-width: none;
    }
  }

  /* The plate frame — same engraved double-frame the specimen figures used,
     so the dark cabinet reads as an atlas plate, not a foreign website. */
  .cabinet {
    max-width: 1160px;
    margin: 14px auto 0;
    border: 1px solid var(--color-rule);
    outline: 1px solid var(--color-border);
    outline-offset: 3px;
    background: #14120e;
    color: #e8dfc8;
  }

  .cab-rail {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 10px 16px;
    border-bottom: 1px solid #2c261b;
    background: linear-gradient(to bottom, #1b1812, #14120e);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: #8f8468;
  }
  .cab-rail-left::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 9px;
    background: #e8a13c;
    box-shadow: 0 0 6px 1px rgb(232 161 60 / 0.55);
  }

  .cab-body {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 1fr);
    gap: 0;
  }
  @media (max-width: 979px) {
    .cab-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------------- Shelf ---------------- */

  .cab-shelf-col {
    padding: 26px 22px 14px;
    border-right: 1px solid #2c261b;
    background:
      radial-gradient(120% 55% at 50% 0%, rgb(232 161 60 / 0.07), transparent 60%),
      #14120e;
  }
  @media (max-width: 979px) {
    .cab-shelf-col {
      border-right: none;
      border-bottom: 1px solid #2c261b;
    }
  }

  .cab-shelf {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 18px;
    row-gap: 30px;
  }
  @media (max-width: 560px) {
    .cab-shelf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 14px;
      row-gap: 26px;
    }
  }

  /* The cartridge. Chassis is pure CSS; the label is the game's own SVG. */
  .cart {
    appearance: none;
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    padding: 15px 9px 11px;
    background: linear-gradient(to bottom, var(--shell-hi), var(--shell) 26%);
    border: 1px solid rgb(0 0 0 / 0.65);
    border-radius: 9px 9px 5px 5px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      inset 0 -4px 0 rgb(0 0 0 / 0.3);
    cursor: pointer;
    text-align: left;
  }
  /* shelf plank each cart stands on */
  .cart::after {
    content: '';
    position: absolute;
    left: -9px;
    right: -9px;
    bottom: -13px;
    height: 7px;
    background: linear-gradient(to bottom, #2b2417, #17130c);
    border-top: 1px solid #3a3120;
    border-bottom: 1px solid #060504;
    border-radius: 1px;
    pointer-events: none;
  }
  /* under-shelf glow when lit */
  .cart::before {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -12px;
    height: 10px;
    background: radial-gradient(50% 100% at 50% 100%, var(--glow), transparent 72%);
    opacity: 0;
    pointer-events: none;
  }

  .cart-grip {
    display: block;
    height: 7px;
    margin: -9px 48px 8px 14px;
    background: repeating-linear-gradient(
      90deg,
      transparent 0 7px,
      rgb(0 0 0 / 0.34) 7px 10px
    );
    border-radius: 0 0 3px 3px;
  }

  /* inventory sticker — cream chip so it reads on every shell color */
  .cart-no {
    position: absolute;
    top: 4px;
    right: 8px;
    padding: 1px 4px 0;
    background: #e8dfc8;
    color: #1f1b14;
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.08em;
    border-radius: 1px;
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.35);
  }

  .cart-label {
    display: block;
