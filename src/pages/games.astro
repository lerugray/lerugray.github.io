  .feedback-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin: 0;
    padding: 0 var(--space-lg);
    background: transparent;
    color: var(--color-ink);
    border: var(--rule-hair) solid var(--color-ink);
    border-radius: var(--radius-card);
    font: inherit;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-micro) var(--ease-out);
