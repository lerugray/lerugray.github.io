<script>
  // THE CABINET — cartridge selection. Mouse-first by operator ruling (2026-08-14):
  // arrows only ever worked once a cart had focus, so the page scrolled instead —
  // the keyboard path stays as a focused-shelf enhancement but is not advertised.
  // Click selects. Enter/Space on the already-selected cart fires its PLAY link. All nine
  // detail panels are server-rendered; JS only toggles `hidden`, so with
  // scripts off the page degrades to the full stacked list (see <noscript>).
  function initCabinet() {
    const cabinetEl = document.getElementById('cabinet');
    if (!cabinetEl) return;
    const cabinet = cabinetEl; // non-null alias (function decls below hoist past the guard)
    const carts = Array.from(cabinet.querySelectorAll<HTMLButtonElement>('.cart'));
    const panels = Array.from(cabinet.querySelectorAll<HTMLElement>('.cab-panel'));
    const status = cabinet.querySelector<HTMLElement>('[data-cab-status]');
    const shelfEl = cabinet.querySelector<HTMLElement>('.cab-shelf');
    const detailEl = cabinet.querySelector<HTMLElement>('.cab-detail');
    if (!carts.length || !panels.length || !shelfEl || !detailEl) return;
    const shelf = shelfEl; // non-null aliases for the function decls below
    const detail = detailEl;

    const narrow = window.matchMedia('(max-width: 979px)');
    const twoUp = window.matchMedia('(max-width: 37.5rem)');
    // Where the details live on a wide screen: the column beside the shelf.
    const detailParent = detail.parentElement;
    const detailNext = detail.nextElementSibling;
    let selected = 0;
    // The cartridge the details open under on narrow screens. Until the player
    // picks one, they close the shelf, so all twelve cartridges read together.
    let anchor = carts.length - 1;

    function shelfCols() {
      return getComputedStyle(shelf).gridTemplateColumns.split(' ').filter(Boolean).length || 3;
    }

    // On narrow screens the details open inside the shelf, directly under the
    // row of the picked cartridge, so a tap shows its build where the player
    // is looking instead of below all twelve cartridges.
    function placeDetail() {
      if (narrow.matches) {
        const cols = shelfCols();
        const rowEnd = Math.min(carts.length - 1, Math.floor(anchor / cols) * cols + cols - 1);
        if (carts[rowEnd].nextElementSibling !== detail) carts[rowEnd].after(detail);
      } else if (detailParent && detail.parentElement !== detailParent) {
        detailParent.insertBefore(detail, detailNext);
      }
    }

    function select(i: number, opts: { scroll?: boolean; initial?: boolean } = {}) {
      // Where the tapped cartridge sits on screen before the details move, so
      // the move never shifts it out from under the player's finger.
      const before = carts[i].getBoundingClientRect().top;
      selected = i;
      if (!opts.initial) anchor = i;
      carts.forEach((c, j) => {
        c.setAttribute('aria-pressed', j === i ? 'true' : 'false');
        c.tabIndex = j === i ? 0 : -1;
      });
      panels.forEach((p, j) => {
        if (j === i) {
          p.hidden = false;
          // retrigger the power-on blip
          p.removeAttribute('data-active');
          void p.offsetWidth;
          p.setAttribute('data-active', 'true');
        } else {
          p.hidden = true;
          p.removeAttribute('data-active');
        }
      });
      const id = carts[i].dataset.game;
      const name = carts[i].querySelector('.sr-only')?.textContent ?? id ?? '';
      if (status) status.textContent = `Selected ${name}`;
      if (id) history.replaceState(null, '', `#${id}`);
      if (id) cabinet.dispatchEvent(new CustomEvent('cab:select', { detail: { id } }));
      placeDetail();
      if (!opts.initial && narrow.matches) {
        const shift = carts[i].getBoundingClientRect().top - before;
        if (shift) window.scrollBy({ top: shift, behavior: 'instant' });
        // Then bring the whole opened drawer on screen at once, by the least
        // scroll that does it: the build's picture, facts and Play, with what
        // fits of the tapped row above them. A drawer taller than the screen
        // starts at its top. No smooth scroll, so the first frame after the
        // tap already shows the details.
        if (opts.scroll) {
          const box = detail.getBoundingClientRect();
          const edge = 16;
          const below = Math.max(0, box.bottom - (window.innerHeight - edge));
          const lift = Math.min(below, box.top - edge);
          if (lift) window.scrollBy({ top: lift, behavior: 'instant' });
        }
      }
    }

    function play(i: number) {
      const id = carts[i].dataset.game;
      const link = id ? cabinet.querySelector<HTMLAnchorElement>(`[data-play="${id}"]`) : null;
      link?.click();
    }

    carts.forEach((cart, i) => {
      cart.addEventListener('click', () => {
        if (i === selected && cart.getAttribute('aria-pressed') === 'true') {
          // second activation on the lit cart = play, arcade-style
          play(i);
          return;
        }
        select(i, { scroll: true });
      });
    });

    shelf.addEventListener('keydown', (e: KeyboardEvent) => {
      // The opened details can sit inside the shelf on narrow screens; keys
      // pressed in there (on Play, say) are not shelf navigation.
      if (!(e.target instanceof HTMLElement) || !e.target.classList.contains('cart')) return;
      const cols = shelfCols();
      let next = -1;
      if (e.key === 'ArrowRight') next = Math.min(selected + 1, carts.length - 1);
      else if (e.key === 'ArrowLeft') next = Math.max(selected - 1, 0);
      else if (e.key === 'ArrowDown') next = Math.min(selected + cols, carts.length - 1);
      else if (e.key === 'ArrowUp') next = Math.max(selected - cols, 0);
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = carts.length - 1;
      else return;
      e.preventDefault();
      if (next !== selected) {
        select(next);
        carts[next].focus();
      }
    });

    // Deep link: /games#<id> selects that cart on load. The field-notes
    // drawers link to #cart-<id> (a real element id, so the jump works with
    // scripts off) — accept that form here too and select it.
    const hash = location.hash.replace('#', '').replace(/^cart-/, '');
    const fromHash = carts.findIndex((c) => c.dataset.game === hash);
    select(fromHash >= 0 ? fromHash : 0, { initial: fromHash < 0 });

    narrow.addEventListener('change', placeDetail);
    twoUp.addEventListener('change', placeDetail);
  }

  initCabinet();
</script>

