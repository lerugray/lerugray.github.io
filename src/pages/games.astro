</style>

<script>
  // THE CABINET — cartridge selection. Mouse-first by operator ruling (2026-08-14):
  // arrows only ever worked once a cart had focus, so the page scrolled instead —
  // the keyboard path stays as a focused-shelf enhancement but is not advertised.
  // Click selects. Enter/Space on the already-selected cart fires its PLAY link. All nine
  // detail panels are server-rendered; JS only toggles `hidden`, so with
  // scripts off the page degrades to the full stacked list (see <noscript>).
  function initCabinet() {
    const cabinetEl = document.getElementById('cabinet');
    if (!cabinetEl) return;
    const cabinet = cabinetEl; // non-null alias (function decls below hoist past the guard)
    const carts = Array.from(cabinet.querySelectorAll<HTMLButtonElement>('.cart'));
    const panels = Array.from(cabinet.querySelectorAll<HTMLElement>('.cab-panel'));
    const status = cabinet.querySelector<HTMLElement>('[data-cab-status]');
    const shelf = cabinet.querySelector<HTMLElement>('.cab-shelf');
    if (!carts.length || !panels.length || !shelf) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let selected = 0;

    function select(i: number, opts: { scroll?: boolean } = {}) {
      selected = i;
      carts.forEach((c, j) => {
        c.setAttribute('aria-pressed', j === i ? 'true' : 'false');
        c.tabIndex = j === i ? 0 : -1;
      });
      panels.forEach((p, j) => {
        if (j === i) {
          p.hidden = false;
          // retrigger the power-on blip
          p.removeAttribute('data-active');
          void p.offsetWidth;
          p.setAttribute('data-active', 'true');
        } else {
          p.hidden = true;
          p.removeAttribute('data-active');
        }
      });
      const id = carts[i].dataset.game;
      const name = carts[i].querySelector('.sr-only')?.textContent ?? id ?? '';
      if (status) status.textContent = `Selected ${name}`;
      if (id) history.replaceState(null, '', `#${id}`);
      if (id) cabinet.dispatchEvent(new CustomEvent('cab:select', { detail: { id } }));
      // On narrow screens the panel sits below the shelf — bring it up.
      if (opts.scroll && window.matchMedia('(max-width: 979px)').matches) {
        panels[i].scrollIntoView({
          behavior: reduceMotion.matches ? 'auto' : 'smooth',
          block: 'nearest',
        });
      }
    }

    function play(i: number) {
      const id = carts[i].dataset.game;
      const link = id ? cabinet.querySelector<HTMLAnchorElement>(`[data-play="${id}"]`) : null;
      link?.click();
    }

    carts.forEach((cart, i) => {
      cart.addEventListener('click', () => {
        if (i === selected && cart.getAttribute('aria-pressed') === 'true') {
          // second activation on the lit cart = play, arcade-style
          play(i);
          return;
        }
        select(i, { scroll: true });
      });
    });

    shelf.addEventListener('keydown', (e: KeyboardEvent) => {
      const cols =
        getComputedStyle(shelf).gridTemplateColumns.split(' ').filter(Boolean).length || 3;
      let next = -1;
      if (e.key === 'ArrowRight') next = Math.min(selected + 1, carts.length - 1);
      else if (e.key === 'ArrowLeft') next = Math.max(selected - 1, 0);
      else if (e.key === 'ArrowDown') next = Math.min(selected + cols, carts.length - 1);
      else if (e.key === 'ArrowUp') next = Math.max(selected - cols, 0);
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = carts.length - 1;
      else return;
      e.preventDefault();
      if (next !== selected) {
        select(next);
        carts[next].focus();
      }
    });

    // Deep link: /games#<id> selects that cart on load. The field-notes
    // drawers link to #cart-<id> (a real element id, so the jump works with
    // scripts off) — accept that form here too and select it.
    const hash = location.hash.replace('#', '').replace(/^cart-/, '');
    const fromHash = carts.findIndex((c) => c.dataset.game === hash);
    select(fromHash >= 0 ? fromHash : 0);
  }

  initCabinet();
</script>

<script>
  // Field notes are SERVER-RENDERED from public/field-trials/devlog.json at
  // build time (see the page frontmatter). The old runtime fetch that built
  // the list in the browser was removed 2026-08-17 — it is superseded, and two
  // renderers for one list is how they drift apart.

  // Field Trials feedback widget. One shared script wires every
  // .feedback-box on the page against its own data-game / data-endpoint.
  // If the endpoint is unreachable (placeholder URL, worker not deployed
  // yet, network hiccup), each box degrades independently to a quiet
  // status line and never shows a broken form.
  interface FeedbackComment {
    id?: number;
    name?: string | null;
    body: string;
    created?: string;
  }

  function formatDate(iso?: string): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '';
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  }

  function renderComments(listEl: HTMLOListElement, comments: FeedbackComment[]) {
    listEl.textContent = '';
    if (!comments.length) {
      const empty = document.createElement('li');
      empty.className = 'feedback-empty';
      empty.textContent = 'No feedback yet — be the first.';
      listEl.appendChild(empty);
      return;
    }
    for (const c of comments) {
      const li = document.createElement('li');
      li.className = 'feedback-comment';

      const meta = document.createElement('p');
      meta.className = 'feedback-comment-meta';
      const who = c.name && c.name.trim() ? c.name.trim() : 'Anonymous';
      const when = formatDate(c.created);
      meta.textContent = when ? `${who} · ${when}` : who;

      const body = document.createElement('p');
      body.className = 'feedback-comment-body';
      body.textContent = c.body;

      li.appendChild(meta);
      li.appendChild(body);
      listEl.appendChild(li);
    }
  }

  function degrade(statusEl: HTMLElement, listEl: HTMLElement, formEl: HTMLElement) {
    statusEl.textContent = 'Feedback wire not yet connected.';
    statusEl.hidden = false;
    listEl.hidden = true;
    formEl.hidden = true;
  }

  async function init() {
    // ONE field-report box for the whole cabinet (Ray, 2026-08-12): the game
    // dropdown replaces the old per-panel boxes; selecting a cartridge files
    // the report under that game automatically.
    const box = document.querySelector<HTMLElement>('.feedback-box');
    const gameSelect = document.querySelector<HTMLSelectElement>('#fr-game');
    if (!box || !gameSelect) return;

    const endpoint = box.dataset.endpoint;
    const statusEl = box.querySelector<HTMLElement>('.feedback-status');
    const listEl = box.querySelector<HTMLOListElement>('.feedback-list');
    const formEl = box.querySelector<HTMLFormElement>('.feedback-form');
    const noteEl = box.querySelector<HTMLElement>('.feedback-note');
    const submitEl = box.querySelector<HTMLButtonElement>('.feedback-submit');
    if (!endpoint || !statusEl || !listEl || !formEl || !noteEl || !submitEl) return;

    let game = gameSelect.value;
    let loadSeq = 0;

    const fetchThread = async (id: string): Promise<FeedbackComment[]> => {
      const res = await fetch(`${endpoint}/comments?game=${encodeURIComponent(id)}`, {
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(`status ${res.status}`);
      const data = await res.json();
      return Array.isArray(data) ? data : [];
    };

    // The first load gates degrade — endpoint unreachable means the whole
    // plate goes quiet, never broken.
    try {
      renderComments(listEl, await fetchThread(game));
    } catch {
      degrade(statusEl, listEl, formEl);
      gameSelect.disabled = true;
      return;
    }

    const showThread = async (id: string) => {
      game = id;
      const seq = ++loadSeq;
      try {
        const comments = await fetchThread(id);
        if (seq === loadSeq) renderComments(listEl, comments);
      } catch {
        if (seq !== loadSeq) return;
        listEl.textContent = '';
        const li = document.createElement('li');
        li.className = 'feedback-empty';
        li.textContent = "Couldn't load this thread right now.";
        listEl.appendChild(li);
      }
    };

    gameSelect.addEventListener('change', () => {
      void showThread(gameSelect.value);
    });

    document.getElementById('cabinet')?.addEventListener('cab:select', ((e: Event) => {
      const id = (e as CustomEvent).detail?.id as string | undefined;
      if (!id || id === gameSelect.value) return;
      if (![...gameSelect.options].some((o) => o.value === id)) return;
      gameSelect.value = id;
      void showThread(id);
    }) as EventListener);

    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(formEl);
      const honeypot = String(data.get('website') || '').trim();
      const body = String(data.get('body') || '').trim();
      const name = String(data.get('name') || '').trim();

      if (!body) {
        noteEl.textContent = 'Say something first.';
        noteEl.classList.add('is-error');
        return;
      }

      submitEl.disabled = true;
      noteEl.textContent = 'Sending…';
      noteEl.classList.remove('is-error');

      try {
        const res = await fetch(`${endpoint}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ game, name: name || undefined, body, website: honeypot }),
        });
        if (!res.ok) throw new Error(`status ${res.status}`);
        const created: FeedbackComment = await res.json();

        const emptyLi = listEl.querySelector('.feedback-empty');
        if (emptyLi) emptyLi.remove();

        const li = document.createElement('li');
        li.className = 'feedback-comment';
        const meta = document.createElement('p');
        meta.className = 'feedback-comment-meta';
        meta.textContent = `${name || 'Anonymous'} · just now`;
        const bodyEl = document.createElement('p');
        bodyEl.className = 'feedback-comment-body';
        bodyEl.textContent = created.body ?? body;
        li.appendChild(meta);
        li.appendChild(bodyEl);
        listEl.insertBefore(li, listEl.firstChild);

        formEl.reset();
        noteEl.textContent = "Thanks — that's in.";
      } catch {
        noteEl.textContent = "Couldn't send that. Try again in a bit.";
        noteEl.classList.add('is-error');
      } finally {
        submitEl.disabled = false;
      }
    });
  }

  init();
</script>
