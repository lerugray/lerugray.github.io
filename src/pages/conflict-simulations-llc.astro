---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Conflict Simulations LLC | Ray Weiss"
  description="Conflict Simulations LLC. Ray Weiss's imprint for historical board wargames and digital games."
>
  <main class="doc">
    <div class="doc__frame">
      <header class="page-heading">
        <h1>Conflict Simulations LLC</h1>
        <p class="dek">Ray Weiss's imprint for board wargames and digital games.</p>
      </header>

      <div class="meta-strip-row">
        <p class="meta-row">
          <span>~30 published wargames</span>
<span>CSR Award nominee</span>
<span>Published by Multi-Man Publishing (Rostov 41, SCS series)</span>
        </p>
      </div>

      <figure>
        <img
          src="/images/csl/gnw-cover.webp"
          alt="The Great Northern War box cover. Peter the Great in armor with faction emblems for Saxony, the Ottoman Empire, and Poland. CSL logo and A Game by Ray Weiss credit."
          width="800"
          loading="eager"
        />
        <figcaption>
          The Great Northern War (2023)
        </figcaption>
      </figure>

      <section>
        <h2>
          Board wargames
        </h2>
        <div class="prose-body">
          <p>
            Operational and strategic-scale historical wargames. Print-on-demand fulfillment out of
            Brooklyn. The full catalog is at <a href="https://consimsltd.com/shop"
              >consimsltd.com/shop</a
            >.
          </p>
          <p>
            Selected titles: 1950 Korea, 1973 Arab-Israeli War, Alma, Koniggratz, Imperial Bayonets,
            DAMOS.
          </p>
        </div>
        <figure>
          <img
            src="/images/csl/gnw-gameplay.webp"
            alt="The Great Northern War in play. Board with wooden army pieces, diplomacy track, and playing cards on a table."
            width="800"
            loading="lazy"
          />
          <figcaption>
            The Great Northern War, mid-game
          </figcaption>
        </figure>
      </section>

      <section>
        <h2>
          Digital games
        </h2>
        <div class="prose-body">
          <p>
            Four titles released on itch under the CSL brand. The full itch catalog is at <a
              href="https://conflict-simulations-llc.itch.io">conflict-simulations-llc.itch.io</a
            >.
          </p>
        </div>
        <div>
          <div class="table-scroll" role="region" aria-label="Scrollable table" tabindex="0">
            <table>
              <thead>
                <tr>
                  <th
                    >Title</th
                  >
                  <th
                    >Price</th
                  >
                  <th
                    >Format</th
                  >
                  <th
                    >Description</th
                  >
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <a href="/devforge"
                      >Devforge</a
                    >
                  </td>
                  <td class="num">$9</td>
                  <td>Windows desktop</td>
                  <td>
                    A game dev terminal that knows your project cold.
                  </td>
                </tr>
                <tr>
                  <td>
                    <a
                      href="/conflict-simulations-llc/veridian-contraption"
                      >Veridian Contraption</a
                    >
                  </td>
                  <td class="num">$3</td>
                  <td>Rust terminal</td>
                  <td>
                    A world-simulator of considerable density and dubious intent.
                  </td>
                </tr>
                <tr>
                  <td>
                    <a
                      href="/conflict-simulations-llc/death-of-an-empire"
                      >Death Of An Empire</a
                    >
                  </td>
                  <td class="num">$3.99</td>
                  <td>Rust terminal</td>
                  <td>Franco-Prussian War, 1870.</td>
                </tr>
                <tr>
                  <td>
                    <a
                      href="https://conflict-simulations-llc.itch.io/prigozhins-march-of-justice"
                      >Prigozhin's March of Justice</a
                    >
                  </td>
                  <td class="num">$2.99</td>
                  <td>Digital</td>
                  <td>
                    Digital version of Ray's solitaire board wargame.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <figure>
          <img
            src="/images/csl/prigozhin-map.webp"
            alt="Prigozhin's March of Justice game map. Route from Rostov-on-Don to Moscow with cities, momentum track, and combat results table. Designer Ray Weiss, art by Ilya Kudriashov."
            width="800"
            loading="lazy"
          />
          <figcaption>
            Prigozhin's March of Justice map (art: Ilya Kudriashov)
          </figcaption>
        </figure>
      </section>

      <section>
        <h2>
          A Contemporary Guide to Wargame Design
        </h2>
        <div class="prose-body">
          <p>
            A practitioner's book on designing historical wargames. Roughly twenty-three chapters,
            drawing on thirty shipped titles. Drafting now; free online reader planned.
          </p>
          <p>
            Public repo: <a href="https://github.com/lerugray/wargame-design-book"
              >github.com/lerugray/wargame-design-book</a
            >.
          </p>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
