---
import { navGroups, isActive } from '@/data/navigation';
const currentPath = Astro.url.pathname;
---

<nav class="directory-nav" aria-label="Site directory">
  {
    navGroups.map((group) => (
      <div class="directory-group">
        <p class="section-label">{group.label}</p>
        <ul>
          {group.items.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isActive(href, currentPath) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
