---
const currentPath = Astro.url.pathname;
const path = currentPath.replace(/\/$/, '') || '/';
const sectionPaths: Record<string, string[]> = {
  '/games': ['/field-trials'],
  '/conflict-simulations-llc': ['/devforge', '/retrogaze', '/hammerstein-ai'],
  '/kit': [
    '/generalstaff',
    '/hammerstein',
    '/hammerstein-model',
    '/mission-brain',
    '/auftragstaktik',
    '/catalogdna',
  ],
  '/about': ['/buddies', '/music', '/works'],
};
const inSection = (section: string) =>
  (sectionPaths[section] || []).some((route) => path === route || path.startsWith(route + '/'));
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="brand-cluster">
      <a href="/" aria-label="Ray Weiss">
        <img
          class="brand-counter"
          src="/counter-rw.svg"
          width="96"
          height="72"
          alt="Ray Weiss unit counter"
        />
      </a>
      <a class="brand-link" href="/" aria-current={path === '/' ? 'page' : undefined}>Ray Weiss</a>
      <span class="brand-locator">Brooklyn, NY</span>
    </div>
    <nav class="site-nav" aria-label="Site navigation">
      <a
        href="/games"
        aria-current={inSection('/games') ||
        currentPath === '/games' ||
        currentPath.startsWith('/games/')
          ? 'page'
          : undefined}>Field Trials</a
      >
      <a
        href="/services"
        aria-current={currentPath === '/services' || currentPath.startsWith('/services/')
          ? 'page'
          : undefined}>Commissions</a
      >
      <a
        href="/wargame-modules"
        aria-current={currentPath === '/wargame-modules' ||
        currentPath.startsWith('/wargame-modules/')
          ? 'page'
          : undefined}>Wargame Modules</a
      >
      <a
        href="/writing"
        aria-current={currentPath === '/writing' || currentPath.startsWith('/writing/')
          ? 'page'
          : undefined}>Writing</a
      >
      <a
        href="/conflict-simulations-llc"
        aria-current={inSection('/conflict-simulations-llc') ||
        currentPath === '/conflict-simulations-llc' ||
        currentPath.startsWith('/conflict-simulations-llc/')
          ? 'page'
          : undefined}>Businesses</a
      >
      <a
        href="/kit"
        aria-current={inSection('/kit') || currentPath === '/kit' || currentPath.startsWith('/kit/')
          ? 'page'
          : undefined}>Tools</a
      >
      <a
        href="/about"
        aria-current={inSection('/about') ||
        currentPath === '/about' ||
        currentPath.startsWith('/about/')
          ? 'page'
          : undefined}>About</a
      >
    </nav>
    <a class="header-contact" href="mailto:rweiss@consimsltd.com">rweiss@consimsltd.com</a>
  </div>
</header>
