---
import SpecLayout from '@/layouts/SpecLayout.astro';
import SiteNav from '@/components/SiteNav.astro';
import '@/styles/utilities.css';
import '@/styles/site-content.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
}

const path = Astro.url.pathname.replace(/\/$/, '');
const ContentContainer =
  ['/games', '/works', '/services', '/kit'].includes(path) || path.startsWith('/writing/')
    ? 'main'
    : 'div';
---

<SpecLayout {...Astro.props}>
  <div class="site-page">
    <ContentContainer
      class:list={['page-content', { 'page-content--home': Astro.url.pathname === '/' }]}
    >
      <slot />
    </ContentContainer>
    <div class="container site-directory">
      <SiteNav />
      <section class="contact-directory" id="contact">
        <p class="label">Contact</p>
        <ul>
          <li>
            <a href="mailto:lerugray@gmail.com">lerugray@gmail.com</a>
          </li>
          <li>
            <a href="https://github.com/lerugray">github.com/lerugray</a>
          </li>
          <li>
            <a href="https://lerug.bandcamp.com">lerug.bandcamp.com</a>
          </li>
          <li>
            <a href="https://conflict-simulations-llc.itch.io">conflict-simulations-llc.itch.io</a>
          </li>
        </ul>
        <div class="imprint">
          <span>Imprint · Brooklyn, NY</span>
          <span class="sep">·</span>
          <span>Set in Newsreader &amp; IBM Plex</span>
          <span class="sep">·</span>
          <span>Edition 2026.04</span>
        </div>
      </section>
    </div>
  </div>
</SpecLayout>
