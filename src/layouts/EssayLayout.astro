---
interface Props {
  title: string;
  publishDate: Date;
  readingTime?: string;
}

const { title, publishDate, readingTime } = Astro.props;

const dateFormatted = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="essay">
  <div class="essay-measure">
    <header class="essay-header page-heading">
      <h1>
        {title}
      </h1>
      <p class="mt-6 font-mono text-xs uppercase tracking-wider text-muted">
        <time datetime={publishDate.toISOString()}>{dateFormatted}</time>
        {
          readingTime && (
            <>
              <span class="mx-3 text-subtle">·</span>
              <span>{readingTime}</span>
            </>
          )
        }
      </p>
    </header>
    <div class="prose-body">
      <slot />
    </div>
  </div>
</article>
