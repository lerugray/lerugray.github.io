---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Personal site of Ray Weiss. Brooklyn wargame designer, running four businesses.',
  image = '/og-image.png',
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ray Weiss" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Ray Weiss. Brooklyn wargame designer, running four businesses."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <style is:inline>
      /* Hallmark · shape: Long Document (pages), Index-First (/) · genre: editorial · theme: Specimen (deal 1/3, seed personal-brooklyn-wargame-designer-8be8·276607cb·2026-10-29·r0) · redesign: full · job: hire
       * hero: Banner (pages, /writing), Settled (/), Stage (/wargame-modules) · nav: edge-aligned, the counter and wordmark left, seven links and the contact address right · footer: index columns (a real sitemap of 37 pages), then contact and a colophon · imagery: the product, Ray's own captures and covers, no library photographs · signature: the name set at poster size in Bodoni with ink-blue guides at its cap height and baseline
       * axes: light/high-contrast-serif/cool · posture: restrained · contrast: pass · fold: pass · copy: verbatim · v2.0.0 */
      /* Hallmark · pre-emit critique: P4 H5 E4 S4 R5 V4 · weakest: S, the Specimen material belongs to a foundry; the RW unit counter, the dated essay index and Ray's own module captures carry the specificity */
      /* Hallmark · hero-review: fix · 5 findings · 3 resolved 2 partial (the nav repeats the location and the address on /, the statement runs past the action) */
      /* Hallmark · finish-review: fix · subagent · 7 findings · 7 resolved · gap: the old home showed the commissions on its first screen, the new one gives that screen to the name and the action; the old cabinet gave each game a drawn picture, the new roster shows the selected game's real capture */
      /* Hallmark · waive 79 · document pages open on a Banner and their prose starts under it inside the same frame, above the fold · the render tier counts only section boundaries, so the essay and product text that follows the banner reads to it as empty paper */
      /* Hallmark · waive 49b · entry titles in the essay, business and catalog indexes are names that cannot shorten, two lines at most on a phone · essay titles and game names are Ray's own and wrap rather than truncate */
      /* Hallmark · waive 39b · Play and Send stand 48px; only the twelve roster cells on Field Trials run taller · each roster cell is the specimen of one build, its name set in Bodoni over its register, and selecting it fills the cell ink */
      /* Hallmark · reworded "Digital wargame modules →" to "Digital wargame modules" · 63 names the arrow glued to link text */
      /* Hallmark · reworded "AI workflow & automation builds →" to "AI workflow & automation builds" · 63 names the arrow glued to link text */
      /* Hallmark · reworded "Custom voice & persona models →" to "Custom voice & persona models" · 63 names the arrow glued to link text */
      /* Hallmark · reworded "Game-design consultation →" to "Game-design consultation" · 63 names the arrow glued to link text */
      /* Hallmark · dropped 08246642135531 · the clue digits of the drawn Jacquard Index nonogram on one of the twelve cartridge labels dropped from Field Trials; 47c and 80 name drawn imitation hardware, and each build now shows its real capture */
      /* Hallmark · dismissed 77 · Long Document pages are one continuous text under a Banner, so their section count is the document's own and not a landing strip */
      /* Hallmark · dismissed 49 · the roster cells on Field Trials are square buttons whose names wrap inside the cell by design, and the manual link is a title that cannot shorten */
      /* Hallmark · answered F1 · the words are Ray's as typed under copy verbatim, so straight apostrophes stay until he sets them himself */
    </style>
  </head>
  <body>
    <SiteHeader />

    <slot />

    <SiteFooter />
    <style is:global>
      html,
      body {
        overflow-x: clip;
      }
    </style>
  </body>
</html>
