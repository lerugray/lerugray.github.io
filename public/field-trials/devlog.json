    },
    {
      "name": "Lines of Advance",
      "blurb": "A digitization of the mechanics of Debord's A Game of War, presented as a sleek modern chess-style program.",
      "status": "in development",
      "url": ""
    },
    {
      "name": "The Office of the Road",
      "blurb": "A streamlined JRPG roguelite — the party marches itself through FF3-style jobs and tarot-card interventions, and the player is the desk it reports to.",
      "status": "in development",
      "url": "https://lerugray.github.io/field-trials/office-of-the-road/"
    },
    {
      "name": "Capriole",
      "blurb": "A first-person hop-and-bop roguelite — a clockwork goat triple-jumps up a vault of flat-shaded floating islands, the way a 1995 PlayStation dreamed.",
      "status": "in development",
      "url": "https://lerugray.github.io/field-trials/capriole/"
    },
    {
      "name": "THE JACQUARD INDEX",
      "blurb": "The pattern library of Reedmoor Mill, est. 1889. Nonograms that never ask you to guess — every card proved solvable by deduction alone, one twist per drawer.",
      "status": "in development",
      "url": "https://lerugray.github.io/field-trials/jacquard-index/"
    },
    {
      "name": "SHOELEATHER",
      "blurb": "You watch the murder. Then you prove it. A 70s-TV inverted mystery — typed facts, contradiction interrogations, one shot at the gotcha.",
      "status": "in development",
      "url": "https://lerugray.github.io/field-trials/shoeleather/"
    },
    {
      "name": "ALKAHEST",
      "blurb": "A match-panel machine on an alchemist's bench. Climb the four acts of the Magnum Opus against rival signatures — the register is the physics.",
      "status": "in development",
      "url": "https://lerugray.github.io/field-trials/alkahest/"
    },
    {
      "name": "Popinjay",
      "blurb": "A single-screen arcade roguelite on Pang's bouncing-balloon core — a 1900s World's Fair sharpshooter, wire-as-wall commitment, hand-tinted poster idiom.",
      "status": "in development",
      "url": "https://lerugray.github.io/field-trials/popinjay/"
    },
    {
      "name": "Material Breach",
      "blurb": "You run the dungeon. Adventurers are an occupational incident, filed with a root-cause analysis and a corrective-action owner.",
      "status": "in development",
      "url": "https://lerugray.github.io/field-trials/material-breach/"
    }
